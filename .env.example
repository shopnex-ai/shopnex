DATABASE_URL=postgres://postgres:postgres@localhost:5432/shopnex
# Signs sessions, encrypts provider keys saved in the admin and signs preview links. Generated into /data when unset in Docker.
SHOPNEX_SECRET=change-me-to-a-long-random-string
# Public origin of the app
APP_URL=http://localhost:3000

# OAuth (optional) — a provider shows up only when both values are set
# Callback URLs: {APP_URL}/api/auth/callback/google  and  .../callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Tenancy: single (default) = one shop, everyone joins it; multi = shops by host / active shop
TENANCY_MODE=single
# multi mode only: true lets anyone sign up at /admin/signup and get their own shop (public demo / SaaS)
OPEN_SIGNUP=false
# multi mode only: every shop is also served at <slug>.ROOT_DOMAIN with no DNS step (acme.shopnex.app). Needs wildcard
# DNS and TLS for *.ROOT_DOMAIN pointing at the storefront. Custom domains still work and can't be under it.
# ROOT_DOMAIN=shopnex.app
# Open sign-up limits per hour: per visitor address (default 5) and for everyone together (default 200)
# SIGNUP_RATE_PER_IP=5
# SIGNUP_RATE_GLOBAL=200
# The request header that carries the visitor's address, for those limits and Better Auth's: cf-connecting-ip behind
# Cloudflare. Default x-forwarded-for, which is useless behind most proxies; without an address only the global cap applies.
# CLIENT_IP_HEADER=cf-connecting-ip
DEFAULT_SHOP_NAME=My Shop

# Public origin of this app (hosted checkout links)
APP_URL=http://localhost:3000
# Storefront origin used when no Storefront URL is saved in Settings (`pnpm dev` sets it to the bundled
# storefront). Single-shop installs only; set it in production to skip that setting.
# STOREFRONT_URL=https://shop.example.com

# App Marketplace (:3200): a separate hosted service. Instances connect to it from Admin → Apps
MARKETPLACE_URL=http://localhost:3200

# Bundled apps (apps/stripe, :4600) run next to ShopNex. Each is its own app, with its own private key
# (<NAME>_APP_KEY, next to <NAME>_APP_URL): its identity, and it seals the keys merchants save in the app (ShopNex
# stores them sealed). Keep it: a new key makes it a new app and merchants reconnect. Make one with
# `node scripts/app-keygen.mjs`. Nothing is written to a folder or a volume. Only CJ Dropshipping has tables of its own,
# in a schema (app_cj) of APP_DATABASE_URL, else DATABASE_URL when that is a Postgres URL; pglite:<folder> is the
# embedded database for trying things out.
# ShopNex registers each app from its URL (Settings → Payments → Install).
# APP_DATABASE_URL=postgres://postgres:postgres@localhost:5432/shopnex
# STRIPE_APP_KEY=snxk_…
# STRIPE_APP_URL: the app's public origin, reachable by browsers (and by Stripe when it's https; locally use
# `stripe listen`). In Docker each app is its own container on its own URL, e.g. https://stripe.example.com
STRIPE_APP_URL=http://localhost:4600
# CJ_DROPSHIPPING_APP_URL: the CJ Dropshipping app (apps/cj-dropshipping, :4700); leave unset to skip it
# CJ_DROPSHIPPING_APP_URL=http://localhost:4700
# CJ_DROPSHIPPING_APP_KEY=snxk_…
# SHIPPO_APP_URL: the Shippo shipping app (apps/shippo, :4900); leave unset to skip it
# SHIPPO_APP_URL=http://localhost:4900
# SHIPPO_APP_KEY=snxk_…
# Under Docker the compose files set SHOPNEX_BUNDLED_APPS=docker instead: ShopNex finds the apps at their service names
# and each app announces its own public URL, so these two are only for a custom domain (set on the app service).
# If an app's public URL is not reachable from ShopNex's server, <NAME>_APP_INTERNAL_URL (STRIPE_APP_INTERNAL_URL=
# http://stripe:4600) is the address the server uses, and SHOPNEX_INTERNAL_URL the one the app uses to call ShopNex.

# Analytics for hosted deployments (demo.shopnex.ai, the public demo). Leave unset: self-hosted installs send nothing and
# ShopNex has no telemetry. Set both only to send pageviews to your own PostHog project.
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://eu.i.posthog.com
