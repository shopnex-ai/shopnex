DATABASE_URL=postgres://postgres:postgres@localhost:5432/shopnex
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# OAuth (optional) — a provider shows up only when both values are set
# Callback URLs: {BETTER_AUTH_URL}/api/auth/callback/google  and  .../callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Tenancy: single (default) = one shop, everyone joins it; multi = shops by host / active shop
TENANCY_MODE=single
DEFAULT_SHOP_NAME=My Shop

# Public origin of this app (hosted checkout links)
APP_URL=http://localhost:3000

# App Marketplace (:3200): a separate hosted service. Instances connect to it from Admin → Apps
MARKETPLACE_URL=http://localhost:3200

# Stripe (apps/stripe, :4600): bundled payments app, runs next to Shopnex and stores nothing itself (the
# merchant's Stripe keys live in the shop's app data, encrypted with the app's key).
# Shopnex registers it from these values (Settings → Payments → Install); the app reads the same ones.
# STRIPE_APP_URL must be reachable by browsers (and by Stripe when it's https; locally use `stripe listen`).
# STRIPE_APP_KEY: the app's private key, from `pnpm app:keygen` (Shopnex derives the public half from it).
STRIPE_APP_URL=http://localhost:4600
STRIPE_APP_KEY=
