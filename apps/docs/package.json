{
  "name": "@shopnex/docs",
  "private": true,
  "type": "module",
  "version": "0.14.0",
  "description": "ShopNex documentation site (Fumadocs on Next.js)",
  "scripts": {
    "dev": "pnpm generate && next dev --port 3400",
    "build": "pnpm generate && next build",
    "postinstall": "fumadocs-mdx",
    "typecheck": "pnpm generate && fumadocs-mdx && tsc && pnpm samples",
    "openapi": "tsx scripts/generate-openapi.ts",
    "reference": "tsx scripts/generate-reference.ts",
    "generate": "pnpm openapi && pnpm reference",
    "preview": "pnpm dlx serve out -l 3400",
    "samples": "tsx scripts/check-samples.ts"
  },
  "dependencies": {
    "@orpc/openapi": "^1.16.1",
    "@orpc/zod": "^1.16.1",
    "@shopnex/api": "workspace:*",
    "@shopnex/app": "workspace:*",
    "@shopnex/marketplace-sdk": "workspace:*",
    "@shopnex/storefront-sdk": "workspace:*",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.8",
    "hono": "catalog:",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.36.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "catalog:",
    "tsx": "^4.23.15"
  }
}
