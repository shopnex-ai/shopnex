{
  "name": "@shopnex/docs",
  "private": true,
  "type": "module",
  "description": "Shopnex documentation site (Fumadocs on Next.js)",
  "scripts": {
    "dev": "next dev --port 3400",
    "build": "pnpm openapi && next build",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && tsc",
    "openapi": "tsx scripts/generate-openapi.ts",
    "preview": "pnpm dlx serve out -l 3400"
  },
  "dependencies": {
    "@orpc/openapi": "^1.16.1",
    "@orpc/zod": "^1.16.1",
    "@shopnex/api": "workspace:*",
    "@shopnex/storefront-sdk": "workspace:*",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.8",
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.0",
    "tailwindcss": "catalog:",
    "tsx": "^4.23.15"
  }
}
