{
  "name": "@shopnex/shippo",
  "private": true,
  "type": "module",
  "description": "Bundled shipping app: live Shippo rates at checkout as a ShopNex carrier service, built on @shopnex/app",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.tsx",
    "start": "tsx --env-file-if-exists=../../.env src/server.tsx",
    "typecheck": "tsc",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@shopnex/app": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.23.15"
  }
}
