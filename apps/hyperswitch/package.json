{
  "name": "@shopnex/hyperswitch",
  "private": true,
  "type": "module",
  "description": "Bundled payments app: card payments through Hyperswitch Prism (Stripe, Adyen, … behind one API), built on @shopnex/app",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.tsx",
    "start": "tsx --env-file-if-exists=../../.env src/server.tsx",
    "typecheck": "tsc",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "prune-native": "node scripts/prune-native.mjs",
    "generate-connectors": "node scripts/generate-connectors.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@shopnex/app": "workspace:*",
    "hono": "catalog:",
    "hyperswitch-prism": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.23.15"
  }
}
