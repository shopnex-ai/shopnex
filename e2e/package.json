{
  "name": "@shopnex/e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --env-file-if-exists=../.env --test --test-concurrency=1 'tests/**/*.test.ts'",
    "typecheck": "tsc",
    "test:ci": "tsx --env-file-if-exists=../.env --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=api-results.xml 'tests/**/*.test.ts'",
    "test:browser": "node --env-file-if-exists=../.env node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@shopnex/app": "workspace:*",
    "@shopnex/apps": "workspace:*",
    "@shopnex/auth": "workspace:*",
    "@shopnex/cart": "workspace:*",
    "@shopnex/catalog": "workspace:*",
    "@shopnex/channels": "workspace:*",
    "@shopnex/db": "workspace:*",
    "@shopnex/email": "workspace:*",
    "@shopnex/marketplace-sdk": "workspace:*",
    "@shopnex/orders": "workspace:*",
    "@shopnex/payments": "workspace:*",
    "@shopnex/pricing": "workspace:*",
    "@shopnex/tenancy": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "1.64.1",
    "@types/node": "catalog:",
    "tsx": "^4.23.15"
  }
}
