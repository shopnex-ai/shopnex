{
  "name": "@shopnex/api",
  "description": "Hono app and oRPC router: the admin, storefront and OpenAPI endpoints",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/router.ts",
    "./reference": "./src/reference.ts"
  },
  "scripts": {
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc",
    "demo:seed": "tsx --env-file-if-exists=../../.env scripts/demo-seed.ts",
    "demo:products": "tsx --env-file-if-exists=../../.env scripts/demo-products.ts",
    "demo:orders": "tsx --env-file-if-exists=../../.env scripts/demo-orders.ts",
    "demo:reset": "tsx scripts/demo-reset.ts"
  },
  "dependencies": {
    "@orpc/openapi": "^1.16.5",
    "@orpc/server": "catalog:",
    "@orpc/zod": "^1.16.5",
    "@shopnex/ai": "workspace:*",
    "@shopnex/apps": "workspace:*",
    "@shopnex/auth": "workspace:*",
    "@shopnex/cart": "workspace:*",
    "@shopnex/catalog": "workspace:*",
    "@shopnex/channels": "workspace:*",
    "@shopnex/content": "workspace:*",
    "@shopnex/core": "workspace:*",
    "@shopnex/custom-fields": "workspace:*",
    "@shopnex/customers": "workspace:*",
    "@shopnex/email": "workspace:*",
    "@shopnex/files": "workspace:*",
    "@shopnex/kit": "workspace:*",
    "@shopnex/log": "workspace:*",
    "@shopnex/marketplace-sdk": "workspace:*",
    "@shopnex/orders": "workspace:*",
    "@shopnex/payments": "workspace:*",
    "@shopnex/gift-cards": "workspace:*",
    "@shopnex/store-import": "workspace:*",
    "@shopnex/languages": "workspace:*",
    "@shopnex/pricing": "workspace:*",
    "@shopnex/privacy": "workspace:*",
    "@shopnex/rpc": "workspace:*",
    "@shopnex/storefront": "workspace:*",
    "@shopnex/storefront-sdk": "workspace:*",
    "@shopnex/tenancy": "workspace:*",
    "@shopnex/theme": "workspace:*",
    "@shopnex/webhooks": "workspace:*",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@shopnex/db": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "^4.23.15"
  }
}
