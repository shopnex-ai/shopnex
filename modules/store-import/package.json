{
  "name": "@shopnex/store-import",
  "description": "Import a Shopify or WooCommerce store into a shop from its public address",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/store-import.schema.ts",
    "./contract": "./src/store-import.contract.ts",
    "./router": "./src/store-import.router.ts",
    "./module": "./src/store-import.module.ts"
  },
  "scripts": {
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@orpc/server": "catalog:",
    "@shopnex/catalog": "workspace:*",
    "@shopnex/content": "workspace:*",
    "@shopnex/custom-fields": "workspace:*",
    "@shopnex/core": "workspace:*",
    "@shopnex/db": "workspace:*",
    "@shopnex/kit": "workspace:*",
    "@shopnex/log": "workspace:*",
    "@shopnex/rpc": "workspace:*",
    "@shopnex/theme": "workspace:*",
    "@shopnex/webhooks": "workspace:*",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.23.15"
  }
}
