{
  "name": "shopnex-storefront",
  "private": true,
  "type": "module",
  "version": "0.16.1",
  "description": "The ShopNex storefront: renders the shop's chosen theme. Themes are Liquid templates in themes/.",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/themes.mjs && astro build",
    "build:themes": "node scripts/themes.mjs",
    "themes:compat": "tsx scripts/theme-compat.ts",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@astrojs/node": "11.1.14",
    "@nanostores/react": "^2.0.1",
    "@shopnex/storefront-sdk": "workspace:*",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "^7.4.13",
    "liquidjs": "10.30.1",
    "nanostores": "^1.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "swiper": "^14.4.0",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/cli": "4.3.5",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
