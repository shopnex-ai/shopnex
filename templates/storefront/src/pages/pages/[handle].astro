---
import { orNull, shopnex } from '../../core/shopnex'
import { loadTheme, render } from '../../core/theme'

const [theme, page] = await Promise.all([
  loadTheme(Astro.url),
  orNull(shopnex.pages.getByHandle({ handle: Astro.params.handle! })),
])
return render(theme, Astro.url, page ? { template: 'page', page } : { template: '404' })
---
