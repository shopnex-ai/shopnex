---
import { orNull, shopnex } from '../../core/shopnex'
import { loadTheme, render } from '../../core/theme'

const [theme, product] = await Promise.all([
  loadTheme(Astro.url),
  orNull(shopnex.products.getByHandle({ handle: Astro.params.handle! })),
])
return render(theme, Astro.url, product ? { template: 'product', product } : { template: '404' })
---
