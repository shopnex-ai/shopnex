# When started from the repo root (`pnpm dev`), SHOPNEX_URL is set automatically.
# Use this file to run the storefront on its own (`pnpm dev` in this folder).

SHOPNEX_URL=http://localhost:3000
# Only when buyers' browsers reach Shopnex at another address than this server does
SHOPNEX_PUBLIC_URL=
# pk_… from the admin (Settings → publishable keys); optional in single-tenant mode
SHOPNEX_PUBLISHABLE_KEY=
