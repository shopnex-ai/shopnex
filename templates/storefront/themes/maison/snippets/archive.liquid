{%- comment -%}
  Maison's archive: a printed rail of collections beside the products, with Grid / List views (src/archive.ts).
  The catalog pages add sort options and paging; the home page's archive section links to the full catalog.

    products     the products shown
    active       handle of the collection shown ('all' for all products)
    view         'grid' or 'list'
    collection   catalog pages: the collection template's collection (sort options)
    paginate     catalog pages: next / first page links
    more_url     home page: where "the whole archive" lives
{%- endcomment -%}
<div id="archive" data-archive class="flex flex-wrap items-start gap-x-[52px] gap-y-6 pt-8">
  <aside class="min-w-0 basis-full lg:sticky lg:top-[86px] lg:max-w-[260px] lg:flex-[1_1_220px] lg:basis-auto">
    <div class="eti mb-[11px] text-muted">Collections</div>
    <ul class="flex flex-wrap gap-x-5 gap-y-[9px] lg:flex-col">
      <li>
        <a
          href="/products"
          class="flex min-h-[22px] items-baseline gap-2.5 text-[13.5px] transition hover:text-acc {% if active == 'all' %}text-acc{% else %}text-ink{% endif %}"
        >
          {%- if active == 'all' %}
            <span class="font-mono text-[11px] text-acc">✕</span>
          {%- else %}
            <span class="font-mono text-[11px] text-faint">·</span>
          {%- endif %}
          All products
        </a>
      </li>
      {%- for c in collections %}
        <li>
          <a
            href="{{ c.url }}"
            class="flex min-h-[22px] items-baseline gap-2.5 text-[13.5px] transition hover:text-acc {% if active == c.handle %}text-acc{% else %}text-ink{% endif %}"
          >
            {%- if active == c.handle %}
              <span class="font-mono text-[11px] text-acc">✕</span>
            {%- else %}
              <span class="font-mono text-[11px] text-faint">·</span>
            {%- endif %}
            {{ c.title }}
          </a>
        </li>
      {%- endfor %}
    </ul>
  </aside>

  <section class="flex min-w-0 flex-[999_1_520px] flex-col gap-6">
    <div class="flex flex-wrap items-center gap-x-[18px] gap-y-3 border-b border-line pb-3.5">
      <span class="eti text-muted" style="font-size:11px">
        {{- products.size }} {{ products.size | pluralize: 'piece', 'pieces' }}
        {%- if paginate.next %} on this page{% endif -%}
      </span>
      <span class="flex-1"></span>
      {%- if collection.sort_options.size > 0 %}
        <select
          data-sort
          aria-label="Sort"
          class="rounded-[2px] border border-rule bg-transparent px-2.5 py-1.5 text-[13px] text-ink outline-none"
        >
          {%- for option in collection.sort_options %}
            <option value="{{ option.url }}" {% if option.selected %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor %}
        </select>
      {%- endif %}
      <div class="eti flex gap-3.5" style="font-size:11px">
        <button
          type="button"
          data-view-btn="grid"
          class="cursor-pointer text-soft transition hover:text-acc [&.on]:border-b [&.on]:border-acc [&.on]:pb-[3px] [&.on]:text-acc {% if view != 'list' %}on{% endif %}"
        >
          Grid
        </button>
        <button
          type="button"
          data-view-btn="list"
          class="cursor-pointer text-soft transition hover:text-acc [&.on]:border-b [&.on]:border-acc [&.on]:pb-[3px] [&.on]:text-acc {% if view == 'list' %}on{% endif %}"
        >
          List
        </button>
      </div>
    </div>

    {%- if products.size == 0 %}
      <div class="py-[72px] text-center text-muted">
        <div class="font-sf mb-3 text-[22px]">Nothing in the archive yet</div>
        {%- if active != 'all' %}
          <a href="/products" class="link-rule text-acc">See all products</a>
        {%- endif %}
      </div>
    {%- else %}
      {% render 'pieces', products: products, view: view %}
    {%- endif %}

    {%- if paginate.next or paginate.first %}
      <div class="flex justify-center gap-4 pt-6">
        {%- if paginate.first %}
          <a class="btn-keeper px-5 py-3" href="{{ paginate.first.url }}">First page</a>
        {%- endif %}
        {%- if paginate.next %}
          <a class="btn-keeper px-5 py-3" href="{{ paginate.next.url }}">Next page</a>
        {%- endif %}
      </div>
    {%- endif %}
    {%- if more_url and products.size > 0 %}
      <a href="{{ more_url }}" class="link-rule self-start text-acc">The whole archive →</a>
    {%- endif %}
  </section>
</div>
