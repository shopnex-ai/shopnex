{%- comment -%}
  A product's price ("From" when variants differ) and its compare-at price, struck through.
  {% render 'price', product: product, class: '…' %}
{%- endcomment -%}
<span class="flex flex-wrap items-baseline gap-x-2.5 font-mono {{ class }}">
  <span>{% if product.price_varies %}From {% endif %}{{ product.price_min | money }}</span>
  {%- if product.compare_at_price_max > product.price_min %}
    <s class="text-[0.85em] text-faint">{{ product.compare_at_price_max | money }}</s>
  {%- endif %}
</span>
