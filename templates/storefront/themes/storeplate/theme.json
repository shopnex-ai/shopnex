{
  "id": "storeplate",
  "name": "Storeplate",
  "version": "1.0.0",
  "settings": [
    {
      "id": "logo",
      "label": "Logo",
      "info": "Image URL. Without one, the shop name is shown.",
      "type": "image"
    },
    {
      "id": "logo_width",
      "label": "Logo width",
      "type": "range",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "id": "color_primary",
      "label": "Buttons",
      "type": "color",
      "default": "#121212"
    },
    {
      "id": "color_body",
      "label": "Background",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "id": "color_border",
      "label": "Borders",
      "type": "color",
      "default": "#eaeaea"
    },
    {
      "id": "color_light",
      "label": "Light background",
      "type": "color",
      "default": "#f2f2f2"
    },
    {
      "id": "color_dark",
      "label": "Dark accents",
      "type": "color",
      "default": "#000000"
    },
    {
      "id": "color_text",
      "label": "Text",
      "type": "color",
      "default": "#444444"
    },
    {
      "id": "color_text_dark",
      "label": "Headings",
      "type": "color",
      "default": "#000000"
    },
    {
      "id": "color_text_light",
      "label": "Muted text",
      "type": "color",
      "default": "#666666"
    },
    {
      "id": "font",
      "label": "Font",
      "type": "select",
      "options": [
        {
          "value": "Karla",
          "label": "Karla"
        },
        {
          "value": "Inter",
          "label": "Inter"
        },
        {
          "value": "Work Sans",
          "label": "Work Sans"
        },
        {
          "value": "DM Sans",
          "label": "DM Sans"
        },
        {
          "value": "Lora",
          "label": "Lora"
        }
      ],
      "default": "Karla"
    },
    {
      "id": "sticky_header",
      "label": "Sticky header",
      "type": "checkbox",
      "default": true
    },
    {
      "id": "show_language_selector",
      "label": "Show language selector",
      "info": "A picker in the header for the languages you publish (Settings → Languages). Shown only when you publish one besides your own.",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "show_country_selector",
      "label": "Show country selector",
      "info": "A picker in the header for the countries you ship to (Settings → General → Ship-to countries). Shown only when there are two or more.",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "announcement_text",
      "label": "Announcement bar (one message)",
      "info": "Shown only while Header → Announcement bar has no announcements of its own",
      "type": "text"
    },
    {
      "id": "announcement_link",
      "label": "Announcement link",
      "type": "url"
    },
    {
      "id": "footer_text",
      "label": "Footer text",
      "info": "Defaults to © year and the shop name",
      "type": "text"
    },
    {
      "id": "instagram_url",
      "group": "Social links",
      "label": "Instagram",
      "type": "url"
    },
    {
      "id": "facebook_url",
      "group": "Social links",
      "label": "Facebook",
      "type": "url"
    },
    {
      "id": "x_url",
      "group": "Social links",
      "label": "X (Twitter)",
      "type": "url"
    },
    {
      "id": "tiktok_url",
      "group": "Social links",
      "label": "TikTok",
      "type": "url"
    },
    {
      "id": "youtube_url",
      "group": "Social links",
      "label": "YouTube",
      "type": "url"
    },
    {
      "id": "pinterest_url",
      "group": "Social links",
      "label": "Pinterest",
      "type": "url"
    },
    {
      "id": "favicon",
      "label": "Favicon",
      "type": "image",
      "info": "The small icon in the browser tab. A square image, at least 32×32 pixels. Without one, the theme's own is used"
    },
    {
      "id": "custom_css",
      "label": "Custom CSS",
      "type": "code",
      "language": "css"
    }
  ],
  "checkout": {
    "background": "color_body",
    "text": "color_text_dark",
    "accent": "color_primary",
    "headingFont": "font",
    "bodyFont": "font",
    "logo": "logo"
  },
  "sections": {
    "hero_slider": {
      "name": "Hero slider",
      "settings": [
        {
          "id": "collection",
          "label": "Products from",
          "info": "One slide per product. Empty: the newest products.",
          "type": "collection"
        },
        {
          "id": "count",
          "label": "Slides",
          "type": "range",
          "min": 1,
          "max": 8,
          "step": 1,
          "default": 3
        },
        {
          "id": "button_label",
          "label": "Button",
          "type": "text",
          "default": "Shop Now"
        }
      ],
      "limit": 1
    },
    "collections": {
      "name": "Collections",
      "settings": [
        {
          "id": "heading",
          "label": "Heading",
          "type": "text",
          "default": "Collections"
        },
        {
          "id": "count",
          "label": "Collections shown",
          "type": "range",
          "min": 2,
          "max": 12,
          "step": 1,
          "default": 6
        }
      ]
    },
    "featured_products": {
      "name": "Featured products",
      "settings": [
        {
          "id": "heading",
          "label": "Heading",
          "type": "text",
          "default": "Featured Products"
        },
        {
          "id": "subheading",
          "label": "Subheading",
          "type": "text",
          "default": "Explore Today’s Featured Picks!"
        },
        {
          "id": "collection",
          "label": "Products from",
          "info": "Empty: the newest products.",
          "type": "collection"
        },
        {
          "id": "count",
          "label": "Products shown",
          "type": "range",
          "min": 4,
          "max": 16,
          "step": 4,
          "default": 8
        },
        {
          "id": "show_all",
          "label": "Show “See all products” button",
          "type": "checkbox",
          "default": true
        }
      ]
    },
    "call_to_action": {
      "name": "Call to action",
      "settings": [
        {
          "id": "subheading",
          "label": "Subheading",
          "type": "text",
          "default": "New arrivals"
        },
        {
          "id": "heading",
          "label": "Heading",
          "type": "text",
          "default": "Discover our new collection"
        },
        {
          "id": "text",
          "label": "Text",
          "type": "textarea",
          "default": "Fresh arrivals, picked for you."
        },
        {
          "id": "image",
          "label": "Image",
          "type": "image",
          "default": "/shopnex/assets/storeplate/call-to-action.png"
        },
        {
          "id": "button_label",
          "label": "Button",
          "type": "text",
          "default": "Shop Now"
        },
        {
          "id": "button_link",
          "label": "Button link",
          "type": "url",
          "default": "/products"
        }
      ]
    },
    "rich_text": {
      "name": "Rich text",
      "settings": [
        {
          "id": "heading",
          "label": "Heading",
          "type": "text",
          "default": "Talk about your brand"
        },
        {
          "id": "text",
          "label": "Text",
          "type": "textarea",
          "default": "Share what makes your products special, your story, or what buyers can expect."
        }
      ]
    },
    "custom_html": {
      "name": "Custom HTML",
      "settings": [
        {
          "id": "html",
          "label": "HTML",
          "type": "code",
          "language": "html"
        }
      ]
    },
    "announcement-bar": {
      "name": "Announcement bar",
      "limit": 1,
      "max_blocks": 12,
      "settings": [
        {
          "id": "auto_rotate",
          "label": "Rotate announcements automatically",
          "info": "Only with two or more announcements. Visitors get a pause button.",
          "type": "checkbox",
          "default": false
        },
        {
          "id": "speed",
          "label": "Seconds per announcement",
          "type": "range",
          "min": 3,
          "max": 10,
          "step": 1,
          "default": 5
        }
      ],
      "blocks": {
        "announcement": {
          "name": "Announcement",
          "settings": [
            {
              "id": "text",
              "label": "Text",
              "type": "text",
              "default": "Welcome to our store"
            },
            {
              "id": "link",
              "label": "Link",
              "type": "url"
            }
          ]
        }
      }
    }
  },
  "pages": {
    "home": {
      "name": "Home page",
      "sections": [
        {
          "id": "hero",
          "type": "hero_slider",
          "settings": {}
        },
        {
          "id": "collections",
          "type": "collections",
          "settings": {}
        },
        {
          "id": "featured",
          "type": "featured_products",
          "settings": {}
        },
        {
          "id": "cta",
          "type": "call_to_action",
          "settings": {}
        }
      ]
    },
    "collection": {
      "name": "Product listing",
      "path": "/products",
      "sections": []
    },
    "static": {
      "name": "Header",
      "sections": [
        {
          "id": "announcement-bar",
          "type": "announcement-bar",
          "settings": {},
          "blocks": []
        }
      ]
    }
  },
  "presets": {
    "sand": {
      "name": "Sand",
      "description": "Warm neutrals with an earthy accent",
      "settings": {
        "color_primary": "#8a5a3b",
        "color_body": "#fdfaf6",
        "color_border": "#eadfd2",
        "color_light": "#f4ede4",
        "color_dark": "#2b2118",
        "color_text": "#4a3f35",
        "color_text_dark": "#2b2118",
        "color_text_light": "#7d6e60",
        "font": "Lora"
      }
    },
    "ocean": {
      "name": "Ocean",
      "description": "Crisp white with deep blue",
      "settings": {
        "color_primary": "#1f4e79",
        "color_body": "#ffffff",
        "color_border": "#dbe6f0",
        "color_light": "#eef4f9",
        "color_dark": "#0f2a42",
        "color_text": "#3d4b59",
        "color_text_dark": "#0f2a42",
        "color_text_light": "#6b7c8c",
        "font": "DM Sans"
      }
    }
  }
}
