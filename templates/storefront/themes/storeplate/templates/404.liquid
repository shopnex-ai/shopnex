{%- assign page_title = 'Page not found' -%}
<section class="section-sm text-center">
  <div class="container">
    <div class="row justify-center">
      <div class="sm:col-10 md:col-8 lg:col-6">
        <img class="mx-auto mb-10" src="{{ '404.png' | asset_url }}" alt="" width="538" height="198" />
        <h1 class="h2 mb-4">{{ 'error.page_not_found' | t }}</h1>
        <p class="mb-8">{{ 'error.the_page_youre_looking_for_doesnt' | t }}</p>
        <a href="/" class="btn btn-primary">{{ 'error.back_to_home' | t }}</a>
      </div>
    </div>
  </div>
</section>
