      "id": "footer_text",
      "label": "Footer text",
      "group": "Footer",
      "type": "text",
      "info": "Defaults to © year and the shop name"
    },
    {
      "id": "instagram_url",
      "label": "Instagram",
      "group": "Social links",
      "type": "url"
    },
    {
      "id": "facebook_url",
      "label": "Facebook",
      "group": "Social links",
      "type": "url"
    },
    {
      "id": "x_url",
      "label": "X (Twitter)",
