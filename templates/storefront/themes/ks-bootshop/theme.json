{
  "id": "ks-bootshop",
  "name": "KS BootShop",
  "version": "1.0.0",
  "settings": [
    {
      "id": "logo",
      "label": "Logo",
      "info": "Image URL. Without one, the shop name is shown.",
      "group": "Brand",
      "type": "image"
    },
    {
      "id": "logo_width",
      "label": "Logo width",
      "group": "Brand",
      "type": "range",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "id": "favicon",
      "label": "Favicon",
      "group": "Brand",
      "type": "image",
      "info": "The small icon in the browser tab. A square image, at least 32×32 pixels. Without one, the theme's own is used"
    },
    {
      "id": "color_primary",
      "label": "Primary color",
      "group": "Colors",
      "type": "color",
      "default": "#198754",
      "info": "Buttons, links and highlights"
    },
    {
      "id": "color_body_bg",
      "label": "Background color",
      "group": "Colors",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "id": "color_body_color",
      "label": "Text color",
      "group": "Colors",
      "type": "color",
      "default": "#212529"
    },
    {
      "id": "border_radius",
      "label": "Corner radius",
      "group": "Colors",
      "type": "range",
      "min": 0,
      "max": 2,
      "step": 0.25,
      "default": 0.375,
      "unit": "rem"
    },
    {
      "id": "font_headings",
      "label": "Heading font",
      "group": "Typography",
      "type": "select",
      "options": [
        {
          "value": "system",
          "label": "System font"
        },
        {
          "value": "Inter",
          "label": "Inter"
        },
        {
          "value": "Roboto",
          "label": "Roboto"
        },
        {
          "value": "Open Sans",
          "label": "Open Sans"
        },
        {
          "value": "Lato",
          "label": "Lato"
        },
        {
          "value": "Poppins",
          "label": "Poppins"
        },
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Playfair Display",
          "label": "Playfair Display"
        }
      ],
      "default": "Montserrat"
    },
    {
      "id": "font_body",
      "label": "Body font",
      "group": "Typography",
      "type": "select",
      "options": [
        {
          "value": "system",
          "label": "System font"
        },
        {
          "value": "Inter",
          "label": "Inter"
        },
        {
          "value": "Roboto",
          "label": "Roboto"
        },
        {
          "value": "Open Sans",
          "label": "Open Sans"
        },
        {
          "value": "Lato",
          "label": "Lato"
        },
        {
          "value": "Poppins",
          "label": "Poppins"
        },
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Playfair Display",
          "label": "Playfair Display"
        }
