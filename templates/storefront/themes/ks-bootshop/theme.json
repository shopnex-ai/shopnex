    {
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Added after the theme styles on every page",
      "group": "Advanced",
      "type": "code",
      "language": "css"
    },
    {
      "id": "head_html",
      "label": "Head code",
      "info": "Added to the <head> of every page: analytics, pixels, site verification tags",
      "group": "Advanced",
      "type": "code",
      "language": "html"
    }
