        {
          "id": "autoplay",
          "label": "Autoplay",
          "type": "checkbox",
          "default": true
        }
      ],
      "limit": 1,
      "max_blocks": 8,
      "blocks": {
        "slide": {
          "name": "Slide",
          "settings": [
            {
              "id": "image",
              "label": "Image",
              "type": "image"
            },
