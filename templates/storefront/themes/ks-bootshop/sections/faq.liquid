{%- comment -%} FAQ: one question per block, as a Bootstrap accordion; blocks without a question are skipped, and with none the section is not shown {%- endcomment -%}
{%- assign parent = 'ks-faq-' | append: section.id -%}
{%- capture items -%}
  {%- for block in section.blocks %}
    {%- if block.settings.question != blank %}
      {%- assign id = parent | append: '-' | append: block.id -%}
      {% render 'faq-item', id: id, parent: parent, question: block.settings.question, answer: block.settings.answer, attrs: block.shopify_attributes %}
    {%- endif %}
  {%- endfor %}
{%- endcapture -%}
{%- if items != blank -%}
<section class="ks-section {{ section.settings.background }} {{ section.settings.padding }}">
  <div class="container ks-narrow">
    {% render 'section-header', heading: section.settings.heading %}
    <div class="accordion" id="{{ parent }}">
      {{ items }}
    </div>
  </div>
</section>
{%- endif -%}
