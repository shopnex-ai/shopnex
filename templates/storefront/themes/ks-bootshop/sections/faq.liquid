{%- comment -%}
  FAQ: one question per block, as a Bootstrap accordion; blocks without a question are skipped, and with none the section
  is not shown. While there are no blocks, the old numbered settings (up to five questions) are shown.
{%- endcomment -%}
{%- assign parent = 'ks-faq-' | append: section.id -%}
{%- capture items -%}
  {%- for block in section.blocks %}
    {%- if block.settings.question != blank %}
      {%- assign id = parent | append: '-' | append: block.id -%}
      {% render 'faq-item', id: id, parent: parent, question: block.settings.question, answer: block.settings.answer, attrs: block.shopify_attributes %}
    {%- endif %}
  {%- endfor %}
{%- endcapture -%}
{%- if items == blank -%}
  {%- capture items -%}
    {%- for i in (1..5) %}
      {%- assign question_key = 'question_' | append: i -%}
      {%- assign answer_key = 'answer_' | append: i -%}
      {%- if section.settings[question_key] != blank %}
        {%- assign id = parent | append: '-' | append: i -%}
        {% render 'faq-item', id: id, parent: parent, question: section.settings[question_key], answer: section.settings[answer_key], attrs: '' %}
      {%- endif %}
    {%- endfor %}
  {%- endcapture -%}
{%- endif -%}
{%- if items != blank -%}
<section class="ks-section {{ section.settings.background }} {{ section.settings.padding }}">
  <div class="container ks-narrow">
    {% render 'section-header', heading: section.settings.heading %}
    <div class="accordion" id="{{ parent }}">
      {{ items }}
    </div>
  </div>
</section>
{%- endif -%}
