{%- comment -%}
  Hero carousel: one slide per block (image, heading, text, button); slides without an image or a heading are skipped.
  A single slide shows no controls. Bootstrap's carousel. While there are no slide blocks, the old numbered settings
  (up to three slides) are shown, for shops that set them before blocks existed.
{%- endcomment -%}
{%- assign slides = '' | split: ',' -%}
{%- for block in section.blocks -%}
  {%- if block.settings.image != blank or block.settings.heading != blank -%}
    {%- assign slides = slides | push: block -%}
  {%- endif -%}
{%- endfor -%}
{%- assign from_blocks = slides.size -%}
{%- if from_blocks == 0 -%}
  {%- for i in (1..3) -%}
    {%- assign image_key = 'image_' | append: i -%}
    {%- assign heading_key = 'heading_' | append: i -%}
    {%- if section.settings[image_key] != blank or section.settings[heading_key] != blank -%}
      {%- assign slides = slides | push: i -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if slides.size > 0 -%}
  <div
    id="ks-hero-{{ section.id }}"
    class="carousel slide ks-hero"
    style="--ks-hero-height: {{ section.settings.height }}"
    {% if section.settings.autoplay and slides.size > 1 %}data-bs-ride="carousel"{% endif %}
  >
    {%- if slides.size > 1 %}
      <div class="carousel-indicators">
        {%- for slide in slides %}
          <button
            type="button"
            data-bs-target="#ks-hero-{{ section.id }}"
            data-bs-slide-to="{{ forloop.index0 }}"
            aria-label="Slide {{ forloop.index }}"
            {% if forloop.first %}class="active" aria-current="true"{% endif %}
          ></button>
        {%- endfor %}
      </div>
    {%- endif %}
    <div class="carousel-inner">
      {%- for slide in slides %}
        {%- if from_blocks > 0 %}
          {% render 'hero-slide',
            image: slide.settings.image,
            heading: slide.settings.heading,
            text: slide.settings.text,
            label: slide.settings.button_label,
            link: slide.settings.button_link,
            first: forloop.first,
            attrs: slide.shopify_attributes
          %}
        {%- else %}
          {%- assign image_key = 'image_' | append: slide -%}
          {%- assign heading_key = 'heading_' | append: slide -%}
          {%- assign text_key = 'text_' | append: slide -%}
          {%- assign label_key = 'button_label_' | append: slide -%}
          {%- assign link_key = 'button_link_' | append: slide -%}
          {% render 'hero-slide',
            image: section.settings[image_key],
            heading: section.settings[heading_key],
            text: section.settings[text_key],
            label: section.settings[label_key],
            link: section.settings[link_key],
            first: forloop.first,
            attrs: ''
          %}
        {%- endif %}
      {%- endfor %}
    </div>
    {%- if slides.size > 1 %}
      <button class="carousel-control-prev" type="button" data-bs-target="#ks-hero-{{ section.id }}" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#ks-hero-{{ section.id }}" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    {%- endif %}
  </div>
{%- endif -%}
