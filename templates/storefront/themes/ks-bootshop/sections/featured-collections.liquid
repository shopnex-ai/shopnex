{%- comment -%}
  Featured collections: one collection tile per block, with the collection's image. Without a collection picked in a
  block, the old numbered settings (up to four) are used, and without those the shop's first collections.
{%- endcomment -%}
{%- assign picked = '' | split: ',' -%}
{%- assign from_blocks = false -%}
{%- for block in section.blocks -%}
  {%- if block.settings.collection != blank -%}
    {%- assign picked = picked | push: block -%}
    {%- assign from_blocks = true -%}
  {%- endif -%}
{%- endfor -%}
{%- unless from_blocks -%}
  {%- for i in (1..4) -%}
    {%- assign key = 'collection_' | append: i -%}
    {%- if section.settings[key] != blank -%}
      {%- assign picked = picked | push: section.settings[key] -%}
    {%- endif -%}
  {%- endfor -%}
  {%- comment %} Nothing picked yet: the shop's first collections {% endcomment -%}
  {%- if picked.size == 0 -%}
    {%- assign picked = collections | slice: 0, 4 -%}
  {%- endif -%}
{%- endunless -%}
{%- if picked.size > 0 -%}
  <section class="ks-section {{ section.settings.background }} {{ section.settings.padding }}">
    <div class="container">
      {% render 'section-header', heading: section.settings.heading %}
      <div class="ks-grid" style="--ks-columns: {{ picked.size | at_most: 4 }}">
        {%- for item in picked %}
          {%- if from_blocks %}
            {% render 'collection-tile', c: item.settings.collection, attrs: item.shopify_attributes %}
          {%- else %}
            {% render 'collection-tile', c: item, attrs: '' %}
          {%- endif %}
        {%- endfor %}
      </div>
    </div>
  </section>
{%- endif -%}
