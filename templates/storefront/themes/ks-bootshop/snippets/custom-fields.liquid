{%- comment -%}
  The custom fields the shop shows on the storefront (Settings → Custom fields, "Show on the storefront"), as a list:
  the label is the key ("care_guide" → "Care guide"), booleans read Yes / No, a value that is a link (an uploaded
  file) becomes one. Fields without a value are not listed; nothing is printed when there is none.
  Use: {% render 'custom-fields', fields: product.custom_fields %}
{%- endcomment -%}
{%- capture rows -%}
  {%- for field in fields -%}
    {%- assign value = field[1] -%}
    {%- capture shown -%}
      {%- if value == true -%}
        Yes
      {%- elsif value == false -%}
        No
      {%- elsif value != blank -%}
        {%- assign text = value | append: '' -%}
        {%- assign start = text | slice: 0, 4 -%}
        {%- assign first = text | slice: 0, 1 -%}
        {%- if start == 'http' or first == '/' -%}
          <a href="{{ text }}" class="underline" rel="noopener">View file</a>
        {%- else -%}
          {{ text }}
        {%- endif -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- if shown != blank -%}
      <dt class="col-sm-4">{{ field[0] | replace: '_', ' ' | capitalize }}</dt><dd class="col-sm-8">{{ shown }}</dd>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if rows != blank -%}
<dl class="row mt-4 mb-0">{{ rows }}
</dl>
{%- endif -%}
