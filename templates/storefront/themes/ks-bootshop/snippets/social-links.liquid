{%- comment -%}
  The shop's social links (Theme settings), icons inline so they take the text color. Nothing is shown for a network without
  a link. {% render 'social-links', class: 'wrapper classes', link_class: 'classes of each link' %}
{%- endcomment -%}
{%- capture links -%}
  {%- if settings.instagram_url != blank %}
    <a href="{{ settings.instagram_url }}" aria-label="Instagram" rel="noopener" target="_blank" class="{{ link_class }}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
    </svg>
    </a>
  {%- endif %}
  {%- if settings.facebook_url != blank %}
    <a href="{{ settings.facebook_url }}" aria-label="Facebook" rel="noopener" target="_blank" class="{{ link_class }}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H7.9v3h2.6V21z" />
    </svg>
    </a>
  {%- endif %}
  {%- if settings.x_url != blank %}
    <a href="{{ settings.x_url }}" aria-label="X" rel="noopener" target="_blank" class="{{ link_class }}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.6 3h3.1l-6.8 7.7L22 21h-6.3l-4.9-6.4L5.1 21H2l7.3-8.3L1.6 3h6.4l4.4 5.9zm-1.1 16.2h1.7L7.1 4.7H5.3z" />
    </svg>
    </a>
  {%- endif %}
  {%- if settings.tiktok_url != blank %}
    <a href="{{ settings.tiktok_url }}" aria-label="TikTok" rel="noopener" target="_blank" class="{{ link_class }}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M16.6 3c.4 2.3 1.8 3.8 4.1 4v3c-1.5.1-2.9-.4-4.1-1.2v6.4c0 3.6-2.7 5.8-5.6 5.8-3.2 0-5.7-2.5-5.7-5.6 0-3.4 2.9-6 6.5-5.5v3.1c-1.7-.4-3.4.7-3.4 2.4 0 1.4 1.1 2.5 2.6 2.5 1.6 0 2.6-1.1 2.6-2.9V3z" />
    </svg>
    </a>
  {%- endif %}
  {%- if settings.youtube_url != blank %}
    <a href="{{ settings.youtube_url }}" aria-label="YouTube" rel="noopener" target="_blank" class="{{ link_class }}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3z" />
    </svg>
    </a>
  {%- endif %}
  {%- if settings.pinterest_url != blank %}
    <a href="{{ settings.pinterest_url }}" aria-label="Pinterest" rel="noopener" target="_blank" class="{{ link_class }}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z" />
    </svg>
    </a>
  {%- endif %}
{%- endcapture -%}
{%- if links != blank %}
  <div class="{{ class }}">{{ links }}</div>
{%- endif -%}
