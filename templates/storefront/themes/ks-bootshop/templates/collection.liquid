{%- comment -%} /products and /collections/{handle}: header, sort options, product grid and paging {%- endcomment -%}
{%- assign heading = collection.title -%}
{%- if search.performed -%}
  {%- if search.terms == blank -%}
    {%- assign heading = 'Search' -%}
  {%- else -%}
    {%- assign heading = 'Search results for “' | append: search.terms | append: '”' -%}
  {%- endif -%}
{%- endif -%}
{%- assign description = collection.description | strip_html | strip -%}
<section class="ks-section ks-py-md border-bottom ks-bg-light">
  <div class="container">
    <nav aria-label="Breadcrumb" class="small mb-2">
      <a href="/">Home</a> <span class="text-body-secondary">/</span>
      {% if search.performed %}{{ heading }}{% elsif collection.handle == 'all' %}All products{% else %}{{ collection.title }}{% endif %}
    </nav>
    <h1 class="mb-0">{% if search.performed %}{{ heading }}{% elsif collection.handle == 'all' %}All products{% else %}{{ collection.title }}{% endif %}</h1>
    {%- if description != blank %}
      <p class="lead mt-2 mb-0 ks-narrow-left">{{ description }}</p>
    {%- endif %}
  </div>
</section>
<section class="ks-section ks-py-md">
  <div class="container">
    {% render 'filters', collection: collection, search: search %}
    <div class="ks-toolbar">
      <span class="text-body-secondary">{{ collection.products.size }} {{ collection.products.size | pluralize: 'product', 'products' }}</span>
      {%- if collection.sort_options.size > 0 %}
        <div class="dropdown">
          <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            Sort by:
            {%- for option in collection.sort_options %}{% if option.selected %} {{ option.name }}{% endif %}{% endfor %}
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            {%- for option in collection.sort_options %}
              <li><a class="dropdown-item{% if option.selected %} active{% endif %}" href="{{ option.url }}">{{ option.name }}</a></li>
            {%- endfor %}
          </ul>
        </div>
      {%- endif %}
    </div>

    {%- if collection.products.size == 0 %}
      <div class="text-center py-5">
        <p class="lead">{% if collection.active_filters.size > 0 %}No products match these filters{% elsif search.performed and search.terms == blank %}Search for something{% elsif search.performed %}No products found{% else %}No products found.{% endif %}</p>
        {%- if collection.clear_filters_url %}<a href="{{ collection.clear_filters_url }}" class="btn btn-primary">Clear filters</a>{% elsif collection.handle != 'all' %}<a href="/products" class="btn btn-primary">See all products</a>{% endif %}
      </div>
    {%- else %}
      <div class="ks-grid" style="--ks-columns: 4">
        {%- for product in collection.products %}
          {% render 'product-card', product: product %}
        {%- endfor %}
      </div>
    {%- endif %}

    {%- if paginate.next or paginate.first %}
      <nav class="d-flex justify-content-center gap-3 mt-5" aria-label="Pagination">
        {%- if paginate.first %}<a class="btn btn-outline-primary" href="{{ paginate.first.url }}">First page</a>{% endif %}
        {%- if paginate.next %}<a class="btn btn-primary" href="{{ paginate.next.url }}">Next page</a>{% endif %}
      </nav>
    {%- endif %}
  </div>
</section>
