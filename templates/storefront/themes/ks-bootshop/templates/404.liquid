{%- assign page_title = 'Page not found' -%}
<section class="ks-section ks-py-lg text-center">
  <div class="container ks-narrow">
    <p class="ks-eyebrow">{{ 'error.error_404' | t }}</p>
    <h1 class="mb-3">{{ 'error.page_not_found' | t }}</h1>
    <p class="lead mb-4">{{ 'error.the_page_youre_looking_for_doesnt' | t }}</p>
    <a href="/" class="btn btn-primary">{{ 'error.back_to_the_store' | t }}</a>
  </div>
</section>
