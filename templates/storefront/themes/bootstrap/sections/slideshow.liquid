{%- comment -%}
  Slideshow: up to three slides (image, title, text, button) in a card, Bootstrap's carousel. Slides without
  an image or a title are skipped; a single slide shows no controls.
{%- endcomment -%}
{%- assign slides = '' | split: ',' -%}
{%- for i in (1..3) -%}
  {%- assign image_key = 'image_' | append: i -%}
  {%- assign title_key = 'title_' | append: i -%}
  {%- if section.settings[image_key] != blank or section.settings[title_key] != blank -%}
    {%- assign slides = slides | push: i -%}
  {%- endif -%}
{%- endfor -%}
{%- if slides.size > 0 -%}
  <div class="container">
    <div class="section-slideshow card">
      <div class="card-body">
        <div
          class="carousel slide"
          id="section-{{ section.id }}"
          style="--slideshow-height: {{ section.settings.height }}"
          {% if section.settings.autoplay and slides.size > 1 %}data-bs-ride="carousel"{% endif %}
        >
          {%- if slides.size > 1 %}
            <div class="carousel-indicators">
              {%- for i in slides %}
                <button type="button" data-bs-target="#section-{{ section.id }}" data-bs-slide-to="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"{% if forloop.first %} class="active" aria-current="true"{% endif %}></button>
              {%- endfor %}
            </div>
          {%- endif %}
          <div class="carousel-inner">
            {%- for i in slides %}
              {%- assign image_key = 'image_' | append: i -%}
              {%- assign title_key = 'title_' | append: i -%}
              {%- assign text_key = 'text_' | append: i -%}
              {%- assign label_key = 'button_label_' | append: i -%}
              {%- assign link_key = 'button_link_' | append: i -%}
              <div class="section-slideshow__item carousel-item{% if forloop.first %} active{% endif %}">
                {%- if section.settings[image_key] != blank %}
                  <img class="section-slideshow__item-image d-block w-100" src="{{ section.settings[image_key] }}" alt=""{% unless forloop.first %} loading="lazy"{% endunless %}>
                {%- else %}
                  <div class="section-slideshow__item-image section-slideshow__item-image--empty d-block w-100"></div>
                {%- endif %}
                <div class="section-slideshow__item-caption carousel-caption">
                  <div class="section-slideshow__item-caption-text">
                    {%- if section.settings[title_key] != blank %}
                      {%- if forloop.first %}
                        <h1 class="display-6 fw-bold">{{ section.settings[title_key] }}</h1>
                      {%- else %}
                        <h2 class="display-6 fw-bold">{{ section.settings[title_key] }}</h2>
                      {%- endif %}
                    {%- endif %}
                    {%- if section.settings[text_key] != blank %}
                      <p class="lead">{{ section.settings[text_key] }}</p>
                    {%- endif %}
                  </div>
                  {%- if section.settings[label_key] != blank and section.settings[link_key] != blank %}
                    <a class="btn btn-primary mb-2" href="{{ section.settings[link_key] }}">{{ section.settings[label_key] }}</a>
                  {%- endif %}
                </div>
              </div>
            {%- endfor %}
          </div>
          {%- if slides.size > 1 %}
            <button class="carousel-control-prev" data-bs-slide="prev" data-bs-target="#section-{{ section.id }}" type="button">
              <span aria-hidden="true" class="carousel-control-prev-icon"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" data-bs-slide="next" data-bs-target="#section-{{ section.id }}" type="button">
              <span aria-hidden="true" class="carousel-control-next-icon"></span>
              <span class="visually-hidden">Next</span>
            </button>
          {%- endif %}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
