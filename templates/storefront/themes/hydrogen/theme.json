{
  "id": "hydrogen",
  "name": "Hydrogen",
  "version": "1.0.0",
  "settings": [
    {
      "id": "logo",
      "label": "Logo",
      "info": "Image URL. Without one, the shop name is shown.",
      "group": "Brand",
      "type": "image"
    },
    {
      "id": "logo_width",
      "label": "Logo width",
      "group": "Brand",
      "type": "range",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "id": "favicon",
      "label": "Favicon",
      "group": "Brand",
      "type": "image",
      "info": "The small icon in the browser tab. A square image, at least 32×32 pixels. Without one, the theme's own is used"
    },
    {
      "id": "primary_color",
      "label": "Text color",
      "info": "Text, buttons and lines",
      "group": "Colors",
      "type": "color",
      "default": "#141414"
    },
    {
      "id": "contrast_color",
      "label": "Background color",
      "info": "Pages, the header and the cart",
      "group": "Colors",
      "type": "color",
      "default": "#fafaf9"
    },
    {
      "id": "accent_color",
      "label": "Accent color",
      "info": "Sale prices and notices",
      "group": "Colors",
      "type": "color",
      "default": "#bf4800"
    },
    {
      "id": "heading_font",
      "label": "Heading font",
      "group": "Typography",
      "type": "select",
      "options": [
        {
          "value": "System",
          "label": "Helvetica / system"
        },
        {
          "value": "Inter",
          "label": "Inter"
        },
        {
          "value": "Space Grotesk",
          "label": "Space Grotesk"
        },
        {
          "value": "Playfair Display",
          "label": "Playfair Display"
        },
        {
          "value": "DM Serif Display",
          "label": "DM Serif Display"
        }
      ],
      "default": "System"
    },
    {
      "id": "body_font",
      "label": "Body font",
      "group": "Typography",
      "type": "select",
      "options": [
        {
          "value": "System",
          "label": "Helvetica / system"
        },
        {
          "value": "Inter",
          "label": "Inter"
        },
        {
          "value": "DM Sans",
          "label": "DM Sans"
        },
        {
          "value": "Source Sans 3",
          "label": "Source Sans 3"
        }
      ],
      "default": "System"
    },
    {
      "id": "sticky_header",
      "label": "Sticky header",
      "info": "Shows on the screen as customers scroll up",
      "group": "Header",
      "type": "checkbox",
      "default": true
    },
    {
      "id": "show_language_selector",
      "label": "Show language selector",
      "info": "A picker in the header for the languages you publish (Settings → Languages). Shown only when you publish one besides your own.",
      "group": "Header",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "copyright",
      "label": "Copyright",
      "info": "Defaults to © year and the shop name",
      "group": "Footer",
      "type": "text"
    },
    {
      "id": "shipping_title",
      "label": "Product tab title",
      "group": "Footer",
      "type": "text",
      "default": "Shipping information"
    },
    {
      "id": "shipping_text",
      "label": "Product tab text",
      "info": "A collapsible tab on every product page, e.g. shipping and returns; empty hides it. A blank line starts a new paragraph.",
      "group": "Footer",
      "type": "textarea"
    },
    {
      "id": "x_url",
      "label": "X (Twitter)",
      "group": "Social links",
      "type": "url"
    },
    {
      "id": "facebook_url",
      "label": "Facebook",
      "group": "Social links",
      "type": "url"
    },
    {
      "id": "instagram_url",
      "label": "Instagram",
      "group": "Social links",
      "type": "url"
    },
    {
      "id": "tiktok_url",
      "label": "TikTok",
      "group": "Social links",
      "type": "url"
    },
    {
      "id": "youtube_url",
      "label": "YouTube",
      "group": "Social links",
      "type": "url"
    },
    {
      "id": "pinterest_url",
      "label": "Pinterest",
      "group": "Social links",
      "type": "url"
    },
    {
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Added after the theme styles on every page",
      "group": "Advanced",
      "type": "code",
      "language": "css"
    },
    {
      "id": "head_html",
      "label": "Head HTML",
      "info": "Added to the <head> of every page: analytics, pixels, site verification tags",
      "group": "Advanced",
      "type": "code",
      "language": "html"
    }
  ],
  "checkout": {
    "background": "contrast_color",
    "text": "primary_color",
    "accent": "primary_color",
    "headingFont": "heading_font",
    "bodyFont": "body_font"
  },
  "sections": {
    "image-banner": {
      "name": "Image banner",
      "settings": [
        {
          "id": "image",
          "label": "First image",
          "type": "image",
          "default": "/shopnex/assets/hydrogen/banner-1.jpg"
        },
        {
          "id": "image_2",
          "label": "Second image",
          "info": "Shown beside the first on larger screens",
          "type": "image",
          "default": "/shopnex/assets/hydrogen/banner-2.jpg"
        },
        {
          "id": "heading",
          "label": "Heading",
          "type": "text",
          "info": "Leave empty to show the shop name"
        },
        {
          "id": "text",
          "label": "Text",
          "type": "textarea"
        },
        {
          "id": "button_label",
          "label": "Button label",
          "type": "text",
          "default": "Shop all →"
        },
        {
          "id": "button_link",
          "label": "Button link",
          "type": "url",
          "default": "/products"
        },
        {
          "id": "full_page_height",
          "label": "Full page height",
          "type": "checkbox",
          "default": true
        }
      ]
    },
    "featured-collection": {
      "name": "Featured collection",
      "settings": [
        {
          "id": "heading",
          "label": "Heading",
          "type": "text",
          "default": "Featured collection"
        },
        {
          "id": "collection",
          "label": "Collection",
          "info": "Empty: the newest products",
          "type": "collection"
        },
        {
          "id": "limit",
          "label": "Maximum products to show",
          "type": "range",
          "min": 4,
          "max": 15,
          "step": 1,
          "default": 8
        }
      ]
    },
    "collection-list": {
      "name": "Collection list",
      "settings": [
        {
          "id": "heading",
          "label": "Heading",
          "type": "text",
          "default": "Collections"
        },
        {
          "id": "columns",
          "label": "Columns on desktop",
          "type": "range",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 3
        }
      ],
      "max_blocks": 12,
      "blocks": {
        "collection": {
          "name": "Collection",
          "settings": [
            {
              "id": "collection",
              "label": "Collection",
              "type": "collection"
            }
          ],
          "from_settings": {
            "collection": "collection_{n}"
          }
        }
      }
    },
    "rich-text": {
      "name": "Text",
      "settings": [
        {
          "id": "heading",
          "label": "Heading",
          "type": "text",
          "default": "Talk about your brand"
        },
        {
          "id": "text",
          "label": "Text",
          "info": "A blank line starts a new paragraph",
          "type": "textarea",
          "default": "Share information about your brand with your customers."
        },
        {
          "id": "button_label",
          "label": "Button label",
          "type": "text"
        },
        {
          "id": "button_link",
          "label": "Button link",
          "type": "url",
          "default": "/products"
        }
      ]
    },
    "custom-html": {
      "name": "Custom HTML",
      "settings": [
        {
          "id": "html",
          "label": "HTML",
          "info": "Shown as is, scripts and styles included",
          "type": "code",
          "language": "html",
          "default": "<p>Your HTML here</p>"
        }
      ]
    },
    "footer": {
      "name": "Footer",
      "group": "footer",
      "limit": 1,
      "max_blocks": 6,
      "settings": [],
      "blocks": {
        "text": {
          "name": "Text",
          "settings": [
            {
              "id": "heading",
              "label": "Heading",
              "type": "text",
              "default": "About us"
            },
            {
              "id": "text",
              "label": "Text",
              "type": "textarea"
            }
          ]
        },
        "menu": {
          "name": "Menu",
          "settings": [
            {
              "id": "heading",
              "label": "Heading",
              "type": "text",
              "default": "Links"
            },
            {
              "id": "menu",
              "label": "Menu",
              "type": "text",
              "default": "footer",
              "info": "The handle of a menu from Online store → Navigation"
            }
          ]
        },
        "social": {
          "name": "Social links",
          "limit": 1,
          "settings": []
        }
      }
    }
  },
  "pages": {
    "home": {
      "name": "Home page",
      "sections": [
        {
          "id": "banner",
          "type": "image-banner",
          "settings": {}
        },
        {
          "id": "featured",
          "type": "featured-collection",
          "settings": {}
        },
        {
          "id": "collections",
          "type": "collection-list",
          "settings": {}
        }
      ]
    },
    "static": {
      "name": "Footer",
      "sections": [
        {
          "id": "footer",
          "type": "footer",
          "settings": {},
          "blocks": []
        }
      ]
    }
  },
  "presets": {
    "dark": {
      "name": "Dark",
      "description": "Hydrogen's dark scheme: light text on charcoal, orange accent",
      "settings": {
        "primary_color": "#fafafa",
        "contrast_color": "#202124",
        "accent_color": "#eb5628"
      }
    }
  }
}
