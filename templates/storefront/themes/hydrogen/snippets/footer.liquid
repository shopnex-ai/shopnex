{%- comment -%}
  Hydrogen's footer: the footer menu (Online store → Navigation, "footer") as titled columns (links with
  children each make a column, the others share "Quick links"), social links, and the copyright line. With the footer
  section's blocks (text, menu and social columns) those are the columns instead: {% render 'footer', blocks: section.blocks %}
{%- endcomment -%}
{%- assign copyright = settings.copyright | strip -%}
{%- if copyright == blank -%}
  {%- capture copyright %}© {{ 'now' | date: '%Y' }}, {{ shop.name }}{% endcapture -%}
{%- endif -%}
{%- assign menu = linklists['footer'] -%}
<footer class="min-h-[25rem] w-full grid-cols-1 border-b border-none bg-contrast px-6 py-8 text-primary md:grid md:grid-flow-row md:grid-cols-2 md:items-start md:gap-8 md:px-8 lg:grid-cols-[repeat(auto-fill,minmax(260px,1fr))] lg:gap-12 lg:px-12">
  {%- if blocks.size > 0 -%}
    {%- for block in blocks %}
      {%- case block.type %}
        {%- when 'text' %}
          {%- capture body %}<p class="m-0 whitespace-pre-line">{{ block.settings.text }}</p>{% endcapture -%}
          {% render 'footer-column', title: block.settings.heading, links: body, attrs: block.shopify_attributes %}
        {%- when 'menu' %}
          {%- assign block_menu = linklists[block.settings.menu] -%}
          {%- capture body -%}
            {%- for link in block_menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
          {%- endcapture -%}
          {% render 'footer-column', title: block.settings.heading, links: body, attrs: block.shopify_attributes %}
        {%- when 'social' %}
          {%- capture socials -%}{% render 'footer-social-links' %}{%- endcapture -%}
          {%- if socials != blank %}
            <div {{ block.shopify_attributes }} class="flex gap-4 pt-10 md:pt-0">{{ socials }}</div>
          {%- endif %}
      {%- endcase %}
    {%- endfor %}
  {%- elsif menu and menu.links.size > 0 -%}
    {%- for link in menu.links %}
      {%- if link.links.size > 0 %}
        {%- capture links -%}
          {%- for child in link.links -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endfor -%}
        {%- endcapture -%}
        {% render 'footer-column', title: link.title, links: links %}
      {%- endif %}
    {%- endfor %}
    {%- capture loose_links -%}
      {%- for link in menu.links -%}
        {%- if link.links.size == 0 -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if loose_links != blank %}
      {% render 'footer-column', title: 'Quick links', links: loose_links %}
    {%- endif %}
  {%- else -%}
    {%- comment %} No footer menu yet: the catalog and its collections {% endcomment %}
    {%- capture links -%}
      <a href="/products">{{ 'collection.all_products' | t }}</a>
      {%- for c in collections limit: 5 -%}<a href="{{ c.url }}">{{ c.title }}</a>{%- endfor -%}
    {%- endcapture -%}
    {% render 'footer-column', title: 'Shop', links: links %}
  {%- endif -%}

  {%- capture socials -%}
    {% render 'footer-social-links' %}
  {%- endcapture -%}
  {%- if blocks.size == 0 and socials != blank %}
    <div class="flex gap-4 pt-10 md:pt-0">{{ socials }}</div>
  {%- endif %}

  <div class="self-end pt-14 opacity-50 md:col-span-2 md:pt-8 lg:col-span-full">
    <a href="/">{{ copyright }}</a>
  </div>
</footer>
