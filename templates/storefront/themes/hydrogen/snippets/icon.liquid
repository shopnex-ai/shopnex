{%- comment -%}
  Hydrogen's icons, inline so they take the text color. {% render 'icon', name: 'bag', class: 'icon' %}
{%- endcomment -%}
{%- case name -%}
  {%- when 'instagram' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
    </svg>
  {%- when 'facebook' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H7.9v3h2.6V21z" />
    </svg>
  {%- when 'x' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.6 3h3.1l-6.8 7.7L22 21h-6.3l-4.9-6.4L5.1 21H2l7.3-8.3L1.6 3h6.4l4.4 5.9zm-1.1 16.2h1.7L7.1 4.7H5.3z" />
    </svg>
  {%- when 'tiktok' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M16.6 3c.4 2.3 1.8 3.8 4.1 4v3c-1.5.1-2.9-.4-4.1-1.2v6.4c0 3.6-2.7 5.8-5.6 5.8-3.2 0-5.7-2.5-5.7-5.6 0-3.4 2.9-6 6.5-5.5v3.1c-1.7-.4-3.4.7-3.4 2.4 0 1.4 1.1 2.5 2.6 2.5 1.6 0 2.6-1.1 2.6-2.9V3z" />
    </svg>
  {%- when 'youtube' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3z" />
    </svg>
  {%- else -%}
    <svg
      class="{{ class }}"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {%- case name -%}
        {%- when 'bag' -%}
          <path d="M5.5 8h13l1 12h-15z" />
          <path d="M9 8V6.5a3 3 0 0 1 6 0V8" />
        {%- when 'close' -%}
          <path d="M6 6l12 12M18 6L6 18" />
        {%- when 'menu' -%}
          <path d="M4 7h16M4 12h16M4 17h16" />
        {%- when 'caret' -%}
          <path d="M6 9l6 6 6-6" />
        {%- when 'minus' -%}
          <path d="M5 12h14" />
        {%- when 'plus' -%}
          <path d="M12 5v14M5 12h14" />
        {%- when 'arrow-left' -%}
          <path d="M20 12H4M10 6l-6 6 6 6" />
        {%- when 'arrow-right' -%}
          <path d="M4 12h16M14 6l6 6-6 6" />
      {%- endcase -%}
    </svg>
{%- endcase -%}
