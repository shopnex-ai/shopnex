{%- comment -%}
  Hydrogen's product page: the photos in a swipeable row on phones and a two-column grid from md up (every
  third one full width), beside a sticky column with the title, vendor, price, pickers, Add to cart and
  collapsible tabs (the description, and the theme settings' shipping text). The chosen variant is kept in the
  URL (?variant=id); its price and photo follow it (src/product.ts, which reads the product's JSON below).
{%- endcomment -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign images = product.images -%}
{%- if images.size == 0 and variant.image -%}
  {%- assign images = variant.image | concat: images -%}
{%- endif -%}
{%- assign shipping = settings.shipping_text | strip | newline_to_br | split: '<br />
<br />' -%}
<main data-product-form>
  <script type="application/json" data-product-json>
    {{ product | json | raw }}
  </script>
  <div class="grid w-full gap-4 border-none px-0 md:gap-8 md:px-8 lg:px-12">
    <div class="grid items-start md:grid-cols-2 md:gap-6 lg:grid-cols-3 lg:gap-20">
      <div class="swimlane hidden-scroll w-screen md:w-full md:grid-flow-row md:grid-cols-2 md:overflow-visible md:p-0 lg:col-span-2">
        {%- for image in images %}
          {%- assign slot = forloop.index0 | modulo: 3 -%}
          {%- if slot == 0 -%}
            {%- assign span = 'md:col-span-2' -%}
          {%- else -%}
            {%- assign span = 'md:col-span-1 md:aspect-[4/5]' -%}
          {%- endif -%}
          <div
            data-gallery-image="{{ image | image_url }}"
            class="aspect-square w-mobileGallery snap-center overflow-hidden rounded bg-contrast/10 md:w-full {{ span }}"
          >
            <img
              src="{{ image | image_url }}"
              alt="{{ image.alt | default: product.title }}"
              {% unless forloop.first %}loading="lazy"{% endunless %}
              class="aspect-[inherit] h-full w-full object-cover object-center"
            />
          </div>
        {%- endfor %}
      </div>

      <div class="md:sticky md:top-[calc(var(--height-nav)+2rem)]">
        <div class="flex w-full max-w-xl flex-col p-6 md:mx-auto md:max-w-sm md:px-0 [&>*+*]:my-4 [&>*:first-child]:mt-0">
          <h1 class="font-heading text-heading">{{ product.title }}</h1>
          {%- if product.vendor != blank %}
            <p class="m-0 text-copy">{{ product.vendor }}</p>
          {%- endif %}

          <div class="relative z-0 flex gap-4 text-copy">
            <span data-price>{{ variant.price | money }}</span>
            {%- assign has_compare = false -%}
            {%- if variant.compare_at_price > variant.price -%}{%- assign has_compare = true -%}{%- endif %}
            <s data-compare-at class="opacity-50 {% unless has_compare %}hidden{% endunless %}">
              {%- if has_compare %}{{ variant.compare_at_price | money }}{% endif -%}
            </s>
          </div>

          {%- unless product.has_only_default_variant %}
            <div class="mb-10 grid gap-4">
              {%- for option in product.options_with_values %}
                <div class="mb-4 flex flex-wrap gap-x-4 gap-y-2 last:mb-0">
                  <span class="block w-full pb-2 text-lead font-bold">{{ option.name }}</span>
                  {%- for value in option.values %}
                    <button
                      type="button"
                      data-option="{{ option.name }}"
                      data-value="{{ value.name }}"
                      aria-pressed="{{ value.selected }}"
                      {% unless value.available %}data-unavailable{% endunless %}
                      class="opt"
                    >
                      {{- value.name -}}
                    </button>
                  {%- endfor %}
                </div>
              {%- endfor %}
            </div>
          {%- endunless %}

          <div class="mb-12 grid items-stretch gap-4">
            <button
              type="button"
              data-add-to-cart="{{ variant.id }}"
              {% unless variant.available %}disabled{% endunless %}
              class="btn w-full"
            >
              <span data-add-label>{% if variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
            </button>
          </div>

          {%- if product.description != blank %}
            <details class="tab mb-10" open>
              <summary>
                <h2 class="flex justify-between text-lead font-bold">
                  Description
                  <span class="icon-caret h-5 w-5">{% render 'icon', name: 'caret', class: 'h-5 w-5' %}</span>
                </h2>
              </summary>
              <div class="rte pt-4 pb-4">{{ product.description }}</div>
            </details>
          {%- endif %}
          {%- if shipping.size > 0 and settings.shipping_title != blank %}
            <details class="tab mb-10">
              <summary>
                <h2 class="flex justify-between text-lead font-bold">
                  {{ settings.shipping_title }}
                  <span class="icon-caret h-5 w-5">{% render 'icon', name: 'caret', class: 'h-5 w-5' %}</span>
                </h2>
              </summary>
              <div class="rte pt-4 pb-4">
                {%- for paragraph in shipping %}
                  {%- assign lines = paragraph | replace: '<br />', '' | strip %}
                  {%- if lines != blank %}<p class="whitespace-pre-line">{{ lines }}</p>{% endif %}
                {%- endfor %}
              </div>
            </details>
          {%- endif %}
        </div>
      </div>
    </div>
  </div>

  {%- if recommendations.products.size > 0 %}
    <section class="grid w-full gap-4 py-6 md:gap-8 md:py-8 lg:py-12">
      <div class="px-6 md:px-8 lg:px-12">
        <h2 class="font-heading text-lead">You may also like</h2>
      </div>
      <div class="swimlane hidden-scroll -mt-1 pt-1 md:scroll-px-8 md:px-8 md:pb-8 lg:scroll-px-12 lg:px-12">
        {%- for p in recommendations.products %}
          {% render 'product-card', product: p, class: 'w-80' %}
        {%- endfor %}
      </div>
    </section>
  {%- endif %}
</main>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json | raw }},
    {%- if product.vendor != blank %}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json | raw }} },
    {%- endif %}
    "image": [
      {%- for image in images -%}
        {{ image | image_url | json | raw }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "description": {{ product.description | strip_html | strip | json | raw }},
    "offers": [
      {%- for v in product.variants -%}
        {
          {%- if v.sku != blank %}"sku": {{ v.sku | json | raw }}, {% endif -%}
          "@type": "Offer",
          "price": {{ v.price | money_without_currency | json | raw }},
          "priceCurrency": {{ v.price.currency | json | raw }},
          "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}"
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
