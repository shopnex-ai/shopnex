{%- comment -%}
  Collection list: a heading over a grid of collection cards (3:2 image, name), one per block. Until a block has a
  collection, the shop's first six are shown.
{%- endcomment -%}
{%- assign picked = '' | split: ',' -%}
{%- for block in section.blocks -%}
  {%- if block.settings.collection -%}{%- assign picked = picked | push: block -%}{%- endif -%}
{%- endfor -%}
{%- assign from_blocks = true -%}
{%- if picked.size == 0 -%}
  {%- assign from_blocks = false -%}
  {%- assign picked = collections | slice: 0, 6 -%}
{%- endif -%}
{%- capture cards -%}
  {%- for item in picked -%}
    {%- if from_blocks -%}
      {% render 'collection-card', c: item.settings.collection, attrs: item.shopify_attributes %}
    {%- else -%}
      {% render 'collection-card', c: item, attrs: '' %}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if cards != blank -%}
  <section class="grid w-full gap-4 p-6 md:gap-8 md:p-8 lg:p-12">
    {%- if section.settings.heading != blank %}
      <h2 class="font-heading text-lead">{{ section.settings.heading }}</h2>
    {%- endif %}
    <div
      class="grid grid-flow-row grid-cols-1 gap-2 gap-y-6 sm:grid-cols-[repeat(var(--columns-desktop),minmax(0,1fr))] md:gap-4 lg:gap-6"
      style="--columns-desktop: {{ section.settings.columns | default: 3 }}"
    >
      {{ cards }}
    </div>
  </section>
{%- endif -%}
