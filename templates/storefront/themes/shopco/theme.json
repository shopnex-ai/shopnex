{
  "id": "shopco",
  "name": "Shopco",
  "version": "1.0.0",
  "settings": [
    {
      "id": "logo",
      "label": "Logo",
      "info": "Image URL. Without one, the shop name is shown.",
      "group": "Brand",
      "type": "image"
    },
    {
      "id": "logo_width",
      "label": "Logo width",
      "group": "Brand",
      "type": "range",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "id": "favicon",
      "label": "Favicon",
      "group": "Brand",
      "type": "image",
      "info": "The small icon in the browser tab. A square image, at least 32×32 pixels. Without one, the theme's own is used"
    },
    {
      "id": "accent_color",
      "label": "Accent color",
      "info": "Buttons, the announcement bar, the brand strip and the newsletter box",
      "group": "Colors",
      "type": "color",
      "default": "#000000"
    },
    {
      "id": "background_color",
      "label": "Background color",
      "group": "Colors",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "id": "text_color",
      "label": "Text color",
      "group": "Colors",
      "type": "color",
      "default": "#000000"
    },
    {
      "id": "surface_color",
      "label": "Panel color",
      "info": "Behind product photos, the footer and the style grid",
      "group": "Colors",
      "type": "color",
      "default": "#f0f0f0"
    },
    {
      "id": "sale_color",
      "label": "Sale color",
      "info": "Discount badges and savings",
      "group": "Colors",
      "type": "color",
      "default": "#ff3333"
    },
    {
      "id": "heading_font",
      "label": "Heading font",
      "group": "Typography",
      "type": "select",
      "options": [
        {
          "value": "Archivo",
          "label": "Archivo Expanded"
        },
        {
          "value": "Archivo Black",
          "label": "Archivo Black"
        },
        {
          "value": "Anton",
          "label": "Anton"
        },
        {
          "value": "Bricolage Grotesque",
          "label": "Bricolage Grotesque"
        }
      ],
      "default": "Archivo"
    },
    {
      "id": "body_font",
      "label": "Body font",
      "group": "Typography",
      "type": "select",
      "options": [
        {
          "value": "Plus Jakarta Sans",
          "label": "Plus Jakarta Sans"
        },
        {
          "value": "DM Sans",
          "label": "DM Sans"
        },
        {
          "value": "Inter",
          "label": "Inter"
        },
        {
          "value": "Manrope",
          "label": "Manrope"
        }
      ],
      "default": "Plus Jakarta Sans"
    },
    {
      "id": "show_language_selector",
      "label": "Show language selector",
      "info": "A picker in the header for the languages you publish (Settings → Languages). Shown only when you publish one besides your own.",
      "group": "Header",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "announcement_text",
      "label": "Announcement (one message)",
      "info": "Shown only while Header → Announcement bar has no announcements of its own",
      "group": "Announcement bar",
      "type": "text"
    },
    {
      "id": "announcement_link_label",
      "label": "Announcement link label",
      "group": "Announcement bar",
      "type": "text"
    },
    {
      "id": "announcement_link",
      "label": "Announcement link",
      "group": "Announcement bar",
      "type": "url"
    },
    {
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "group": "Footer",
      "type": "text",
      "default": "Stay up to date"
    },
    {
      "id": "newsletter_action",
      "label": "Newsletter form URL",
      "info": "Where the email is posted: your email tool's form action (Mailchimp, Kit, Buttondown…). Empty hides the newsletter box.",
      "group": "Footer",
      "type": "url"
    },
    {
      "id": "newsletter_field",
      "label": "Newsletter email field name",
      "info": "The form field your email tool expects, e.g. EMAIL for Mailchimp",
      "group": "Footer",
      "type": "text",
      "default": "email"
    },
    {
      "id": "footer_text",
      "label": "Footer text",
      "info": "Under the shop name in the footer",
      "group": "Footer",
      "type": "textarea"
    },
    {
      "id": "copyright",
      "label": "Copyright line",
      "info": "Defaults to © year and the shop name",
      "group": "Footer",
      "type": "text"
    },
    {
      "id": "shipping_text",
      "label": "Shipping & returns",
      "info": "A tab on every product page; empty hides it. A blank line starts a new paragraph.",
      "group": "Footer",
      "type": "textarea"
    },
    {
      "id": "instagram_url",
      "label": "Instagram",
      "group": "Social links",
      "type": "url"
    },
    {
      "id": "facebook_url",
      "label": "Facebook",
      "group": "Social links",
      "type": "url"
    },
    {
      "id": "x_url",
      "label": "X (Twitter)",
      "group": "Social links",
      "type": "url"
    },
    {
      "id": "tiktok_url",
      "label": "TikTok",
      "group": "Social links",
      "type": "url"
    },
    {
      "id": "youtube_url",
      "label": "YouTube",
      "group": "Social links",
      "type": "url"
    },
    {
      "id": "pinterest_url",
      "label": "Pinterest",
      "group": "Social links",
      "type": "url"
    },
    {
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Added after the theme styles on every page",
      "group": "Advanced",
      "type": "code",
      "language": "css"
    },
    {
      "id": "head_html",
      "label": "Head code",
      "info": "Added to the <head> of every page: analytics, pixels, site verification tags",
      "group": "Advanced",
      "type": "code",
      "language": "html"
    }
  ],
  "checkout": {
    "background": "background_color",
    "text": "text_color",
    "accent": "accent_color",
    "headingFont": "heading_font",
    "bodyFont": "body_font"
  },
  "sections": {
    "hero": {
      "name": "Hero",
      "settings": [
        {
          "id": "heading",
          "label": "Heading",
          "type": "text",
          "default": "Welcome to our store"
        },
        {
          "id": "text",
          "label": "Text",
          "type": "textarea"
        },
        {
          "id": "button_label",
          "label": "Button label",
          "type": "text",
          "default": "Shop now"
        },
        {
          "id": "button_link",
          "label": "Button link",
          "type": "url",
          "default": "/products"
        },
        {
          "id": "image",
          "label": "Image URL",
          "info": "A cut-out photo works best: it sits at the bottom right of the hero",
          "type": "image",
          "default": "/shopnex/assets/shopco/hero.jpg"
        }
      ],
      "limit": 1,
      "max_blocks": 4,
      "blocks": {
        "stat": {
          "name": "Figure",
          "settings": [
            {
              "id": "value",
              "label": "Value",
              "type": "text"
            },
            {
              "id": "label",
              "label": "Label",
              "type": "text"
            }
          ]
        }
      }
    },
    "brands": {
      "name": "Brand strip",
      "settings": [],
      "max_blocks": 8,
      "blocks": {
        "brand": {
          "name": "Brand",
          "settings": [
            {
              "id": "name",
              "label": "Name",
              "type": "text",
              "default": "Brand"
            }
          ]
        }
      }
    },
    "product-row": {
      "name": "Product row",
      "settings": [
        {
          "id": "heading",
          "label": "Heading",
          "type": "text",
          "default": "New arrivals"
        },
        {
          "id": "collection",
          "label": "Collection",
          "info": "Empty: the newest products",
          "type": "collection"
        },
        {
          "id": "limit",
          "label": "Products shown",
          "type": "range",
          "min": 2,
          "max": 12,
          "step": 1,
          "default": 4
        },
        {
          "id": "button_label",
          "label": "Button label",
          "info": "Links to the collection; empty hides it",
          "type": "text",
          "default": "View all"
        },
        {
          "id": "divider",
          "label": "Line above",
          "type": "checkbox",
          "default": false
        }
      ]
    },
    "style-grid": {
      "name": "Collection grid",
      "settings": [
        {
          "id": "heading",
          "label": "Heading",
          "type": "text",
          "default": "Browse by style"
        }
      ],
      "limit": 1,
      "max_blocks": 4,
      "blocks": {
        "collection": {
          "name": "Collection",
          "settings": [
            {
              "id": "collection",
              "label": "Collection",
              "type": "collection"
            }
          ]
        }
      }
    },
    "testimonials": {
      "name": "Testimonials",
      "settings": [
        {
          "id": "heading",
          "label": "Heading",
          "type": "text",
          "default": "What customers say"
        },
        {
          "id": "show_stars",
          "label": "Show five stars",
          "type": "checkbox",
          "default": true
        }
      ],
      "max_blocks": 10,
      "blocks": {
        "quote": {
          "name": "Quote",
          "settings": [
            {
              "id": "name",
              "label": "Name",
              "type": "text"
            },
            {
              "id": "quote",
              "label": "Quote",
              "type": "textarea"
            }
          ]
        }
      }
    },
    "rich-text": {
      "name": "Text",
      "settings": [
        {
          "id": "heading",
          "label": "Heading",
          "type": "text",
          "default": "Talk about your brand"
        },
        {
          "id": "text",
          "label": "Text",
          "info": "A blank line starts a new paragraph",
          "type": "textarea"
        },
        {
          "id": "button_label",
          "label": "Button label",
          "type": "text"
        },
        {
          "id": "button_link",
          "label": "Button link",
          "type": "url",
          "default": "/products"
        }
      ]
    },
    "custom-html": {
      "name": "Custom HTML",
      "settings": [
        {
          "id": "html",
          "label": "HTML",
          "info": "Shown as is, scripts and styles included",
          "type": "code",
          "language": "html",
          "default": "<p style=\"text-align:center\">Your HTML here</p>"
        }
      ]
    },
    "announcement-bar": {
      "name": "Announcement bar",
      "limit": 1,
      "max_blocks": 12,
      "settings": [
        {
          "id": "speed",
          "label": "Seconds per announcement",
          "info": "Only with two or more announcements",
          "type": "range",
          "min": 3,
          "max": 10,
          "step": 1,
          "default": 5
        }
      ],
      "blocks": {
        "announcement": {
          "name": "Announcement",
          "settings": [
            {
              "id": "text",
              "label": "Text",
              "type": "text",
              "default": "Welcome to our store"
            },
            {
              "id": "link_label",
              "label": "Link label",
              "type": "text"
            },
            {
              "id": "link",
              "label": "Link",
              "type": "url"
            }
          ]
        }
      }
    },
    "footer": {
      "name": "Footer",
      "group": "footer",
      "limit": 1,
      "max_blocks": 6,
      "settings": [],
      "blocks": {
        "text": {
          "name": "Text",
          "settings": [
            {
              "id": "heading",
              "label": "Heading",
              "type": "text",
              "default": "About us"
            },
            {
              "id": "text",
              "label": "Text",
              "type": "textarea"
            }
          ]
        },
        "menu": {
          "name": "Menu",
          "settings": [
            {
              "id": "heading",
              "label": "Heading",
              "type": "text",
              "default": "Links"
            },
            {
              "id": "menu",
              "label": "Menu",
              "type": "text",
              "default": "footer",
              "info": "The handle of a menu from Online store → Navigation"
            }
          ]
        }
      }
    }
  },
  "pages": {
    "home": {
      "name": "Home page",
      "sections": [
        {
          "id": "hero",
          "type": "hero",
          "settings": {}
        },
        {
          "id": "brands",
          "type": "brands",
          "settings": {}
        },
        {
          "id": "new-arrivals",
          "type": "product-row",
          "settings": {}
        },
        {
          "id": "top-selling",
          "type": "product-row",
          "settings": {
            "heading": "Top selling",
            "divider": true
          }
        },
        {
          "id": "styles",
          "type": "style-grid",
          "settings": {}
        },
        {
          "id": "testimonials",
          "type": "testimonials",
          "settings": {}
        }
      ]
    },
    "static": {
      "name": "Header",
      "sections": [
        {
          "id": "announcement-bar",
          "type": "announcement-bar",
          "settings": {},
          "blocks": []
        },
        {
          "id": "footer",
          "type": "footer",
          "settings": {},
          "blocks": []
        }
      ]
    }
  },
  "presets": {
    "midnight": {
      "name": "Midnight",
      "description": "Deep navy accents on cool grey, Bricolage headings",
      "settings": {
        "accent_color": "#1b2a4a",
        "surface_color": "#eef0f4",
        "sale_color": "#e0473c",
        "heading_font": "Bricolage Grotesque",
        "body_font": "DM Sans"
      }
    },
    "clay": {
      "name": "Clay",
      "description": "Warm cream and terracotta, Anton headings",
      "settings": {
        "accent_color": "#9c4a2f",
        "background_color": "#fbf8f3",
        "text_color": "#2a211c",
        "surface_color": "#f1e9de",
        "sale_color": "#c2410c",
        "heading_font": "Anton",
        "body_font": "Manrope"
      }
    }
  }
}
