{%- comment -%}
  Every Shopco page: head (theme stylesheet, the merchant's colors and fonts), announcement bar, header,
  footer, cart drawer.
{%- endcomment -%}
{%- comment -%} Google Fonts parameters for the fonts merchants can pick (theme.json: heading_font, body_font) {%- endcomment -%}
{%- assign display_weight = '800' -%}
{%- assign display_stretch = '100%' -%}
{%- case settings.heading_font -%}
  {%- when 'Archivo Black' -%}
    {%- assign heading_spec = 'Archivo+Black' -%}
    {%- assign display_weight = '400' -%}
  {%- when 'Anton' -%}
    {%- assign heading_spec = 'Anton' -%}
    {%- assign display_weight = '400' -%}
  {%- when 'Bricolage Grotesque' -%}
    {%- assign heading_spec = 'Bricolage+Grotesque:opsz,wght@12..96,800' -%}
  {%- else -%}
    {%- assign heading_spec = 'Archivo:wdth,wght@125,800' -%}
    {%- assign display_stretch = '125%' -%}
{%- endcase -%}
{%- case settings.body_font -%}
  {%- when 'DM Sans' -%}
    {%- assign body_spec = 'DM+Sans:wght@400;500;700' -%}
  {%- when 'Inter' -%}
    {%- assign body_spec = 'Inter:wght@400;500;700' -%}
  {%- when 'Manrope' -%}
    {%- assign body_spec = 'Manrope:wght@400;500;700' -%}
  {%- else -%}
    {%- assign body_spec = 'Plus+Jakarta+Sans:wght@400;500;700' -%}
{%- endcase -%}
{%- comment -%}
  Unchanged colors and fonts keep the tokens in theme.css (the defaults here are theme.json's). Color
  settings are validated hex values, so they're safe in CSS. Secondary text and hairlines are mixed from the
  text color in theme.css, so they follow it.
{%- endcomment -%}
{%- capture theme_style -%}
  {%- if settings.accent_color != '#000000' -%}--color-acc:{{ settings.accent_color }};{%- endif -%}
  {%- if settings.background_color != '#ffffff' -%}--color-page:{{ settings.background_color }};{%- endif -%}
  {%- if settings.text_color != '#000000' -%}--color-ink:{{ settings.text_color }};{%- endif -%}
  {%- if settings.surface_color != '#f0f0f0' -%}
    --color-surface:{{ settings.surface_color }};--color-photo:{{ settings.surface_color }};--color-hero:{{ settings.surface_color }};
  {%- endif -%}
  {%- if settings.sale_color != '#ff3333' -%}--color-sale:{{ settings.sale_color }};{%- endif -%}
  {%- if settings.heading_font != 'Archivo' -%}
    --font-display:'{{ settings.heading_font }}', system-ui, sans-serif;--display-weight:{{ display_weight }};--display-stretch:{{ display_stretch }};
  {%- endif -%}
  {%- if settings.body_font != 'Plus Jakarta Sans' -%}
    --font-sans:'{{ settings.body_font }}', system-ui, sans-serif;
  {%- endif -%}
{%- endcapture -%}
{%- if page_title != blank and request.page_type == 'index' -%}
  {%- assign title = page_title -%}
{%- elsif page_title != blank -%}
  {%- assign title = page_title | append: ' — ' | append: shop.name -%}
{%- else -%}
  {%- assign title = shop.name -%}
{%- endif -%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}</title>
    {%- if page_description != blank %}
    <meta name="description" content="{{ page_description }}" />
    {%- endif %}
    <meta property="og:site_name" content="{{ shop.name }}" />
    <meta property="og:title" content="{{ title }}" />
    {%- if page_description != blank %}
    <meta property="og:description" content="{{ page_description }}" />
    {%- endif %}
    {%- if page_image != blank %}
    <meta property="og:image" content="{{ page_image }}" />
    {%- endif %}
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family={{ heading_spec }}&family={{ body_spec }}&display=swap"
    />
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {%- if theme_style != blank %}
    <style>:root{ {{- theme_style -}} }</style>
    {%- endif %}
    {%- if settings.custom_css != blank %}
    {%- comment %} Code settings are output as is (only staff can edit them); `</style` can't end the tag early {% endcomment %}
    <style>{{ settings.custom_css | replace: '</style', '<\/style' | raw }}</style>
    {%- endif %}
    {{ content_for_header }}
    {{ settings.head_html }}
  </head>
  <body class="flex min-h-screen flex-col bg-page font-sans text-ink antialiased">
    {% render 'header' %}
    <div class="grow">
      {{ content_for_layout }}
    </div>
    {% render 'footer' %}
    {% render 'cart-drawer' %}
    {{ 'theme.js' | asset_url | script_tag }}
  </body>
</html>
