{%- comment -%} Text: a centered heading, plain-text paragraphs (a blank line starts a new one) and a button {%- endcomment -%}
{%- assign paragraphs = section.settings.text | strip | newline_to_br | split: '<br />
<br />
' -%}
<section class="mx-auto flex max-w-[860px] flex-col items-center gap-5 px-4 py-12 text-center md:py-[72px]">
  {%- if section.settings.heading != blank %}
    <h2 class="font-display m-0 text-[32px] md:text-[48px]">{{ section.settings.heading }}</h2>
  {%- endif %}
  {%- for paragraph in paragraphs %}
    {%- assign lines = paragraph | replace: '<br />', '' | strip %}
    {%- if lines != blank %}
      <p class="m-0 max-w-[62ch] text-[16px] leading-[24px] whitespace-pre-line text-soft">{{ lines }}</p>
    {%- endif %}
  {%- endfor %}
  {%- if section.settings.button_label != blank and section.settings.button_link != blank %}
    <a href="{{ section.settings.button_link }}" class="btn mt-2">{{ section.settings.button_label }}</a>
  {%- endif %}
</section>
