{%- comment -%}
  Brand strip: names set in the display type on the accent band, one per block or, without blocks, the vendors of the
  newest products
{%- endcomment -%}
{%- capture items -%}
  {%- for block in section.blocks -%}
    {%- assign label = block.settings.name | strip -%}
    {%- if label != blank -%}
      <span {{ block.shopify_attributes }} class="font-display text-[22px] whitespace-nowrap md:text-[32px]">{{ label }}</span>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if items == blank and section.blocks.size == 0 -%}
  {%- assign names = collections.all.products | map: 'vendor' | compact | uniq -%}
  {%- capture items -%}
    {%- for name in names limit: 8 -%}
      {%- assign label = name | strip -%}
      {%- if label != blank -%}
        <span class="font-display text-[22px] whitespace-nowrap md:text-[32px]">{{ label }}</span>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
{%- endif -%}
{%- if items != blank -%}
  <section class="bg-acc text-on-acc">
    <div class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-center gap-x-8 gap-y-5 px-4 py-10 md:justify-around md:py-11 xl:px-0">
      {{ items }}
    </div>
  </section>
{%- endif -%}
