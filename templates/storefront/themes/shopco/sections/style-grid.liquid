{%- comment -%}
  Collection grid ("Browse by style"): up to four collection tiles (one per block) on a rounded panel, narrow–wide then
  wide–narrow. Until a block has a collection, the shop's first four are shown; a collection's image fills its tile.
{%- endcomment -%}
{%- assign picked = '' | split: ',' -%}
{%- for block in section.blocks -%}
  {%- if block.settings.collection and picked.size < 4 -%}{%- assign picked = picked | push: block -%}{%- endif -%}
{%- endfor -%}
{%- assign from_blocks = true -%}
{%- if picked.size == 0 -%}
  {%- assign from_blocks = false -%}
  {%- assign picked = collections | slice: 0, 4 -%}
{%- endif -%}
{%- capture tiles -%}
  {%- for item in picked -%}
    {%- if forloop.index == 2 or forloop.index == 3 -%}{%- assign span = 'md:col-span-2' -%}{%- else -%}{%- assign span = '' -%}{%- endif -%}
    {%- if from_blocks -%}
      {% render 'style-tile', c: item.settings.collection, span: span, attrs: item.shopify_attributes %}
    {%- else -%}
      {% render 'style-tile', c: item, span: span, attrs: '' %}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if tiles != blank -%}
  <section class="mx-auto max-w-[1240px] px-4 py-6 xl:px-0">
    <div class="flex flex-col items-center gap-7 rounded-[20px] bg-surface px-6 py-10 md:gap-16 md:rounded-[40px] md:px-16 md:py-[70px]">
      {%- if section.settings.heading != blank %}
        <h2 class="font-display m-0 text-center text-[32px] md:text-[48px]">{{ section.settings.heading }}</h2>
      {%- endif %}
      <div class="grid w-full grid-cols-1 gap-4 md:grid-cols-3 md:gap-5">{{ tiles }}</div>
    </div>
  </section>
{%- endif -%}
