{%- comment -%}
  Shopco's product page: gallery (thumbnails beside the photo on desktop, under it on phones), then title,
  price with the saving, colour swatches (options named Color / Colour) and pill pickers for other options,
  quantity and Add to cart. Tabs below: the description, and shipping & returns from the theme settings.
  The chosen variant is kept in the URL (?variant=id); its price and image follow it (src/product.ts, which
  reads the product's JSON below).
{%- endcomment -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign images = product.images -%}
{%- if images.size == 0 and variant.image -%}
  {%- assign images = variant.image | concat: images -%}
{%- endif -%}
{%- assign main_image = variant.image | default: images.first -%}
{%- assign excerpt = product.description | strip_html | strip | truncatewords: 40 -%}
{%- assign shipping = settings.shipping_text | strip | newline_to_br | split: '<br />
<br />
' -%}
<main class="mx-auto max-w-[1240px] px-4 xl:px-0">
  <hr class="m-0 border-line" />
  {% render 'breadcrumbs', parent: collections.all, current: product.title %}

  <section class="flex flex-col gap-5 pb-12 md:flex-row md:gap-10 md:pb-20" data-product-form>
    <script type="application/json" data-product-json>
      {{ product | json | raw }}
    </script>
    <div class="flex min-w-0 flex-col gap-3 md:flex-1 lg:flex-row-reverse lg:gap-3.5">
      <div class="relative aspect-square overflow-hidden rounded-[20px] bg-photo lg:flex-1">
        {%- if main_image %}
          <img
            data-main-image
            src="{{ main_image | image_url }}"
            alt="{{ main_image.alt | default: product.title }}"
            class="absolute inset-0 h-full w-full object-cover"
          />
        {%- endif %}
      </div>
      {%- if images.size > 1 %}
        <div class="no-scrollbar flex gap-3 overflow-x-auto lg:w-[152px] lg:flex-none lg:flex-col lg:gap-3.5 lg:overflow-y-auto">
          {%- for image in images limit: 6 %}
            <button
              type="button"
              data-thumb="{{ image | image_url }}"
              aria-label="Show {{ image.alt | default: 'image' }}"
              class="relative aspect-square w-[calc((100%-24px)/3)] flex-none cursor-pointer overflow-hidden rounded-[20px] border bg-photo transition lg:w-full {% if image.src == main_image.src %}border-ink{% else %}border-transparent{% endif %}"
            >
              <img src="{{ image | image_url }}" alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
            </button>
          {%- endfor %}
        </div>
      {%- endif %}
    </div>

    <div class="flex min-w-0 flex-col gap-3 md:flex-1 md:gap-3.5">
      {%- if product.vendor != blank %}
        <span class="text-[14px] font-medium tracking-[3px] text-soft uppercase">{{ product.vendor }}</span>
      {%- endif %}
      <h1 class="font-display m-0 text-[24px] leading-[28px] md:text-[40px] md:leading-[44px]">{{ product.title }}</h1>
      <span class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[24px] font-bold md:text-[32px]">
        <span data-price>{{ variant.price | money }}</span>
        {%- assign has_compare = false -%}
        {%- if variant.compare_at_price > variant.price -%}
          {%- assign has_compare = true -%}
          {%- assign saving = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round -%}
        {%- endif %}
        <s data-compare-at class="text-faint {% unless has_compare %}hidden{% endunless %}">
          {%- if has_compare %}{{ variant.compare_at_price | money }}{% endif -%}
        </s>
        <span data-saving class="badge-sale lg {% unless has_compare %}hidden{% endunless %}">
          {%- if has_compare %}-{{ saving }}%{% endif -%}
        </span>
      </span>
      {%- if excerpt != blank %}
        <p class="m-0 text-[14px] leading-[20px] text-soft md:text-[16px] md:leading-[22px]">{{ excerpt }}</p>
      {%- endif %}

      {%- for option in product.options_with_values %}
        {%- assign option_key = option.name | downcase | strip -%}
        <div class="flex flex-col gap-4 border-t border-line pt-5 pb-1 md:pt-6">
          <span class="text-[14px] text-soft md:text-[16px]">
            {{- option.name }}: <span data-selected-value="{{ option.name }}" class="text-ink">{{ option.selected_value }}</span>
          </span>
          <div class="flex flex-wrap gap-2 md:gap-3">
            {%- for value in option.values %}
              {%- if option_key == 'color' or option_key == 'colour' %}
                <button
                  type="button"
                  data-option="{{ option.name }}"
                  data-value="{{ value.name }}"
                  aria-pressed="{{ value.selected }}"
                  aria-label="{{ value.name }}"
                  title="{{ value.name }}"
                  {% unless value.available %}data-unavailable{% endunless %}
                  class="swatch"
                  style="background-color: var(--color-surface); background-color: {{ value.name | handleize | remove: '-' }}"
                >
                  {% render 'icon', name: 'check', class: '' %}
                </button>
              {%- else %}
                <button
                  type="button"
                  data-option="{{ option.name }}"
                  data-value="{{ value.name }}"
                  aria-pressed="{{ value.selected }}"
                  {% unless value.available %}data-unavailable{% endunless %}
                  class="chip"
                >
                  {{- value.name -}}
                </button>
              {%- endif %}
            {%- endfor %}
          </div>
        </div>
      {%- endfor %}

      <div class="flex gap-3 border-t border-line pt-5 md:gap-5 md:pt-6">
        <div class="flex flex-none items-center gap-5 rounded-full bg-surface px-4 py-3 md:px-5">
          <button type="button" data-qty-step="-1" aria-label="One fewer" class="cursor-pointer">
            {% render 'icon', name: 'minus', class: 'h-4 w-4 flex-none md:h-5 md:w-5' %}
          </button>
          <span data-qty-value class="min-w-[2ch] text-center text-[14px] font-medium md:text-[16px]">1</span>
          <button type="button" data-qty-step="1" aria-label="One more" class="cursor-pointer">
            {% render 'icon', name: 'plus', class: 'h-4 w-4 flex-none md:h-5 md:w-5' %}
          </button>
        </div>
        <button
          type="button"
          data-add-to-cart="{{ variant.id }}"
          {% unless variant.available %}disabled{% endunless %}
          class="btn flex-1 px-6 py-3"
        >
          <span data-add-label>{% if variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
        </button>
      </div>
    </div>
  </section>

  {%- if product.description != blank or shipping.size > 0 %}
    <section data-tabs class="pb-12 md:pb-16">
      <div role="tablist" class="flex border-b border-line">
        {%- if product.description != blank %}
          <button
            type="button"
            role="tab"
            data-tab="details"
            aria-selected="true"
            class="flex-1 cursor-pointer border-b-2 border-transparent pb-4 text-[16px] text-soft aria-selected:border-ink aria-selected:font-medium aria-selected:text-ink md:pb-6 md:text-[20px]"
          >
            Product details
          </button>
        {%- endif %}
        {%- if shipping.size > 0 %}
          <button
            type="button"
            role="tab"
            data-tab="shipping"
            aria-selected="{% if product.description == blank %}true{% else %}false{% endif %}"
            class="flex-1 cursor-pointer border-b-2 border-transparent pb-4 text-[16px] text-soft aria-selected:border-ink aria-selected:font-medium aria-selected:text-ink md:pb-6 md:text-[20px]"
          >
            Shipping &amp; returns
          </button>
        {%- endif %}
      </div>
      {%- if product.description != blank %}
        <div role="tabpanel" data-panel="details" class="rte max-w-[80ch] pt-6 md:pt-8">{{ product.description }}</div>
      {%- endif %}
      {%- if shipping.size > 0 %}
        <div role="tabpanel" data-panel="shipping" class="rte max-w-[80ch] pt-6 md:pt-8 {% if product.description != blank %}hidden{% endif %}">
          {%- for paragraph in shipping %}
            {%- assign lines = paragraph | replace: '<br />', '' | strip %}
            {%- if lines != blank %}<p class="whitespace-pre-line">{{ lines }}</p>{% endif %}
          {%- endfor %}
        </div>
      {%- endif %}
    </section>
  {%- endif %}

  {%- if recommendations.products.size > 0 %}
    <section class="flex flex-col items-center gap-8 pb-12 md:gap-14 md:pb-20">
      <h2 class="font-display m-0 text-center text-[32px] md:text-[48px]">You might also like</h2>
      <div class="no-scrollbar -mx-4 flex w-[calc(100%+2rem)] snap-x snap-mandatory gap-4 overflow-x-auto px-4 md:mx-0 md:grid md:w-full md:snap-none md:grid-cols-4 md:gap-5 md:overflow-visible md:px-0">
        {%- for p in recommendations.products %}
          <div class="w-[198px] flex-none snap-start md:w-auto">
            {% render 'product-card', product: p %}
          </div>
        {%- endfor %}
      </div>
    </section>
  {%- endif %}
</main>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json | raw }},
    {%- if product.vendor != blank %}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json | raw }} },
    {%- endif %}
    "image": [
      {%- for image in images -%}
        {{ image | image_url | json | raw }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "description": {{ product.description | strip_html | strip | json | raw }},
    "offers": [
      {%- for v in product.variants -%}
        {
          {%- if v.sku != blank %}"sku": {{ v.sku | json | raw }}, {% endif -%}
          "@type": "Offer",
          "price": {{ v.price | money_without_currency | json | raw }},
          "priceCurrency": {{ v.price.currency | json | raw }},
          "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}"
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
