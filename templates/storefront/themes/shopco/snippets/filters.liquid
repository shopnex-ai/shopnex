{%- comment -%}
  Search, selected filters and filters of a catalog page (/products, /collections/{handle}, /search). Plain links
  and forms, so it works without scripts.

    collection   the collection template's collection (filters, active_filters, clear_filters_url)
    search       the search object (on /search: performed, terms)
{%- endcomment -%}
{%- assign offering = true -%}
{%- if search.performed and search.terms == blank -%}{%- assign offering = false -%}{%- endif -%}
{%- if search.performed %}
  <form action="/search" method="get" role="search" class="flex max-w-xl gap-2">
    <input
      type="search"
      name="q"
      value="{{ search.terms }}"
      placeholder="Search products"
      aria-label="Search products"
      class="min-w-0 flex-1 rounded-full bg-surface px-5 py-3 text-[16px] outline-none"
      autofocus
    />
    <button type="submit" class="btn">Search</button>
  </form>
{%- endif %}
{%- if offering %}
  {%- if collection.active_filters.size > 0 %}
    <div class="flex flex-wrap items-center gap-2">
      {%- for filter in collection.active_filters %}
        <a href="{{ filter.url }}" class="rounded-full bg-surface px-4 py-2 text-[14px] transition hover:text-ink">{{ filter.label }} ✕</a>
      {%- endfor %}
      <a href="{{ collection.clear_filters_url }}" class="text-[14px] text-soft underline">Clear all</a>
    </div>
  {%- endif %}
  {%- if collection.filters.size > 0 %}
    <details class="rounded-[20px] border border-line px-5 py-3" {% if collection.active_filters.size > 0 %}open{% endif %}>
      <summary class="flex cursor-pointer list-none items-center gap-2 text-[16px] font-bold">
        {% render 'icon', name: 'sliders', class: 'ico-sm' %} Filters
      </summary>
      <div class="grid gap-6 pt-4 sm:grid-cols-2 lg:grid-cols-4">
        {%- for group in collection.filters %}
          <div>
            <div class="mb-2 text-[16px] font-bold">{{ group.label }}</div>
            {%- if group.type == 'price_range' %}
              <form action="{{ request.path }}" method="get" class="flex flex-wrap items-center gap-2">
                {%- for field in group.hidden %}
                  <input type="hidden" name="{{ field.name }}" value="{{ field.value }}" />
                {%- endfor %}
                <input type="number" name="{{ group.param_min }}" value="{{ group.selected_min }}" min="0" step="any" placeholder="{{ group.min }}" aria-label="Lowest price" class="w-20 rounded-full bg-surface px-3 py-2 text-[14px] outline-none" />
                <span aria-hidden="true">–</span>
                <input type="number" name="{{ group.param_max }}" value="{{ group.selected_max }}" min="0" step="any" placeholder="{{ group.max }}" aria-label="Highest price" class="w-20 rounded-full bg-surface px-3 py-2 text-[14px] outline-none" />
                <button type="submit" class="btn-line">Apply</button>
              </form>
            {%- else %}
              <ul class="m-0 flex max-h-48 list-none flex-col gap-1 overflow-y-auto p-0">
                {%- for value in group.values %}
                  <li>
                    <a href="{{ value.url }}" class="flex justify-between gap-2 py-1 text-[16px] transition hover:text-ink {% if value.active %}font-bold text-ink{% else %}text-soft{% endif %}">
                      <span>{% if value.active %}✓ {% endif %}{{ value.label }}</span>
                      {%- if value.count %}<span class="text-faint">{{ value.count }}</span>{% endif %}
                    </a>
                  </li>
                {%- endfor %}
              </ul>
            {%- endif %}
          </div>
        {%- endfor %}
      </div>
    </details>
  {%- endif %}
{%- endif %}
