{%- comment -%}
  Shopco's icons, inline so they take the text color. {% render 'icon', name: 'cart', class: 'ico' %}
{%- endcomment -%}
{%- case name -%}
  {%- when 'star' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2.5l2.94 6.1 6.56.86-4.8 4.6 1.2 6.54L12 17.4l-5.9 3.2 1.2-6.54-4.8-4.6 6.56-.86z" />
    </svg>
  {%- when 'sparkle' -%}
    <svg class="{{ class }}" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
      <path d="M50 0c2.4 27.6 22.4 47.6 50 50-27.6 2.4-47.6 22.4-50 50C47.6 72.4 27.6 52.4 0 50 27.6 47.6 47.6 27.6 50 0z" />
    </svg>
  {%- when 'verified' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="10" fill="#01ab31" />
      <path d="M7.5 12.3l3 3 6-6.3" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  {%- when 'instagram' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
    </svg>
  {%- when 'facebook' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H7.9v3h2.6V21z" />
    </svg>
  {%- when 'x' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.6 3h3.1l-6.8 7.7L22 21h-6.3l-4.9-6.4L5.1 21H2l7.3-8.3L1.6 3h6.4l4.4 5.9zm-1.1 16.2h1.7L7.1 4.7H5.3z" />
    </svg>
  {%- when 'tiktok' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M16.6 3c.4 2.3 1.8 3.8 4.1 4v3c-1.5.1-2.9-.4-4.1-1.2v6.4c0 3.6-2.7 5.8-5.6 5.8-3.2 0-5.7-2.5-5.7-5.6 0-3.4 2.9-6 6.5-5.5v3.1c-1.7-.4-3.4.7-3.4 2.4 0 1.4 1.1 2.5 2.6 2.5 1.6 0 2.6-1.1 2.6-2.9V3z" />
    </svg>
  {%- else -%}
    <svg
      class="{{ class }}"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {%- case name -%}
        {%- when 'cart' -%}
          <circle cx="9" cy="20" r="1.3" />
          <circle cx="18" cy="20" r="1.3" />
          <path d="M2.5 3h2.6l2.5 12.2a1.5 1.5 0 0 0 1.5 1.2h9.1a1.5 1.5 0 0 0 1.5-1.2L21.5 7H6" />
        {%- when 'close' -%}
          <path d="M6 6l12 12M18 6L6 18" />
        {%- when 'menu' -%}
          <path d="M3.5 6h17M3.5 12h17M3.5 18h17" />
        {%- when 'chevron-down' -%}
          <path d="M6 9l6 6 6-6" />
        {%- when 'chevron-right' -%}
          <path d="M9 6l6 6-6 6" />
        {%- when 'arrow-left' -%}
          <path d="M20 12H4M10 6l-6 6 6 6" />
        {%- when 'arrow-right' -%}
          <path d="M4 12h16M14 6l6 6-6 6" />
        {%- when 'minus' -%}
          <path d="M5 12h14" />
        {%- when 'plus' -%}
          <path d="M12 5v14M5 12h14" />
        {%- when 'check' -%}
          <path d="M5 12.5l4.5 4.5L19 7.5" />
        {%- when 'trash' -%}
          <path d="M4 7h16M9.5 7V4.5h5V7M6.5 7l1 13h9l1-13M10 11v5.5M14 11v5.5" />
        {%- when 'tag' -%}
          <path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9z" />
          <circle cx="7.5" cy="7.5" r="1.3" />
        {%- when 'mail' -%}
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="M3.5 6.5l8.5 6 8.5-6" />
        {%- when 'sliders' -%}
          <path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0" />
          <circle cx="16" cy="6" r="2" />
          <circle cx="10" cy="12" r="2" />
          <circle cx="18" cy="18" r="2" />
      {%- endcase -%}
    </svg>
{%- endcase -%}
