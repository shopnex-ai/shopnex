# From your app's page in the marketplace developer dashboard (or Admin → Apps → Custom apps). Leave the app's
# Redirect URLs empty: it's a managed app, installed and opened right in the Shopnex admin.
SHOPNEX_CLIENT_ID=app_…
SHOPNEX_APP_KEY=snxk_…
# Marketplace apps: only serve installs the marketplace knows about (anyone can run a Shopnex instance)
SHOPNEX_MARKETPLACE_URL=http://localhost:3200
# Where this app runs: register it as the App URL. It listens on this URL's port; set PORT only when the
# platform assigns one (behind a proxy the public URL has no port)
APP_URL=http://localhost:4500
