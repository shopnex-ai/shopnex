{
  "name": "@shopnex/app",
  "version": "0.14.0",
  "description": "Build ShopNex apps with no database and no OAuth code: authenticate, Admin API, per-shop data, signed requests, and admin-styled UI components",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui.tsx",
    "./store": "./src/store.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "generate": "tsx --env-file-if-exists=../../.env scripts/generate-admin-api.ts",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@shopnex/app-bridge": "workspace:*",
    "@shopnex/marketplace-sdk": "workspace:*",
    "hono": "catalog:",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@orpc/openapi": "^1.16.1",
    "@orpc/zod": "^1.16.1",
    "@shopnex/api": "workspace:^",
    "@types/node": "catalog:",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15"
  }
}
