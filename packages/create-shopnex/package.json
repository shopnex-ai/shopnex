{
  "name": "create-shopnex",
  "version": "0.14.0",
  "description": "Try ShopNex with one command: npx create-shopnex starts the admin and the storefront on an embedded database, nothing else to install",
  "private": true,
  "type": "module",
  "bin": {
    "create-shopnex": "./bin/create-shopnex.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15"
  }
}
