{
  "name": "create-shopnex",
  "version": "0.14.0",
  "description": "Try ShopNex with one command: npx create-shopnex starts the admin and the storefront on an embedded database, nothing else to install",
  "license": "MIT",
  "homepage": "https://shopnex.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopnex-ai/shopnex.git",
    "directory": "packages/create-shopnex"
  },
  "keywords": [
    "shopnex",
    "ecommerce",
    "create-shopnex",
    "storefront"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "create-shopnex": "./bin/create-shopnex.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@clack/prompts": "^0.7.0",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "picocolors": "^1.1.1",
    "tsx": "^4.23.15"
  }
}
