{
  "name": "shopnex",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @shopnex/admin-ui build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @shopnex/db generate",
    "db:migrate": "pnpm --filter @shopnex/db migrate",
    "create-super-admin": "pnpm --filter @shopnex/auth create-super-admin",
    "dev:app": "pnpm --filter @shopnex/admin-ui dev",
    "dev:docs": "pnpm --filter @shopnex/docs dev",
    "dev:stripe": "pnpm --filter @shopnex/stripe dev",
    "e2e": "pnpm --filter @shopnex/e2e test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "app:keygen": "node scripts/app-keygen.mjs",
    "demo:seed": "pnpm --filter @shopnex/api demo:seed",
    "demo:reset": "pnpm --filter @shopnex/api demo:reset"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "3.5.3",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
